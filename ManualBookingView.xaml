
<UserControl x:Class="LobixApp.Views.ManualBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="#0D0E13"
             FontFamily="pack://application:,,,/Fonts/#Peyda">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="PageBg" Color="#0D0E13"/>
        <SolidColorBrush x:Key="PanelBg" Color="#151720"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#1B1E29"/>
        <SolidColorBrush x:Key="InputBg" Color="#10121A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#292D3A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#DB3C45"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C22E39"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#302027"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F7"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#9298AA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#747B8D"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#42C98A"/>
        <SolidColorBrush x:Key="GreenBgBrush" Color="#18372E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E5A93D"/>

        <FontFamily x:Key="PeydaFont">pack://application:,,,/Fonts/#Peyda</FontFamily>

        <!-- GLOBAL TEXT -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource PeydaFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PageHeading" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B7B9C6"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="HintText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- BUTTONS -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource PeydaFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1B1E29"/>
            <Setter Property="BorderBrush" Value="#292D3A"/>
        </Style>

        <!-- TEXTBOX -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource PeydaFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="#30333F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#806B2632"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MinHeight" Value="36"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CARD -->
        <Style x:Key="CardBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="CalendarDayButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="34"
                        Height="34"
                        CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}"
                        Margin="0,0,10,0">
                    <TextBlock Text="＋"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#FF8D96"
                               HorizontalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="رزرو دستی"
                               Style="{StaticResource PageHeading}"/>
                    <TextBlock Text="ثبت سریع رزرو حضوری"
                               FontSize="10"
                               Foreground="{StaticResource SubTextBrush}"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#191B24"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="11,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource GreenBrush}"
                             Margin="0,0,7,0"/>
                    <TextBlock x:Name="OperatorNameTextBlock"
                               Text="اپراتور"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- WORKSPACE -->
        <Border Grid.Row="1"
                Margin="16,2,16,14"
                Style="{StaticResource CardBorder}"
                Padding="12">

            <Grid x:Name="BookingWorkspaceGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ایجاد رزرو"
                                   Style="{StaticResource SectionHeading}"/>

                        <TextBlock x:Name="BookingWizardMessageTextBlock"
                                   Text="  ·  تاریخ، زمان و دستگاه را انتخاب کنید"
                                   FontSize="10"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#583039"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="9,4">
                        <TextBlock Text="رزرو حضوری"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#FF9AA0"/>
                    </Border>
                </Grid>

                <!-- FORM AND MAP -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MinWidth="340"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT FORM -->
                    <Border Grid.Column="0"
                            Background="#11131A"
                            BorderBrush="#292C37"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="11">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- DATE -->
                            <Grid x:Name="BookingDateStepPanel"
                                  Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="تاریخ رزرو"
                                           Style="{StaticResource FieldLabel}"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PersianDateSelectorButton"
                                            Grid.Column="0"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalContentAlignment="Right"
                                            Padding="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▦"
                                                       Foreground="#FF8992"
                                                       FontSize="15"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock x:Name="PersianDateTextBlock"
                                                       Text="در حال تعیین تاریخ"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PersianDateTodayButton"
                                            Grid.Column="2"
                                            Content="امروز"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,7"/>
                                </Grid>

                                <!-- CALENDAR -->
                                <Popup x:Name="PersianCalendarPopup"
                                       PlacementTarget="{Binding ElementName=PersianDateSelectorButton}"
                                       Placement="Bottom"
                                       HorizontalOffset="-120"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">

                                    <Border Width="290"
                                            Margin="0,7,0,0"
                                            Background="#191B24"
                                            BorderBrush="#292D3A"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="5"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="PersianCalendarPreviousButton"
                                                        Grid.Column="0"
                                                        Content="‹"
                                                        FontSize="19"
                                                        Padding="0"
                                                        Height="32"/>

                                                <TextBlock x:Name="PersianCalendarMonthTextBlock"
                                                           Grid.Column="1"
                                                           Text="مهر ۱۴۰۵"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>

                                                <Button x:Name="PersianCalendarNextButton"
                                                        Grid.Column="2"
                                                        Content="›"
                                                        FontSize="19"
                                                        Padding="0"
                                                        Height="32"/>
                                            </Grid>

                                            <UniformGrid Grid.Row="2"
                                                         Columns="7">
                                                <TextBlock Text="ش" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="ی" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="د" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="س" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="چ" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="پ" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="ج" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                            </UniformGrid>

                                            <UniformGrid x:Name="PersianCalendarDaysGrid"
                                                         Grid.Row="4"
                                                         Columns="7"/>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- START TIME -->
                            <Grid x:Name="BookingHourStepPanel"
                                  Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="ساعت شروع"
                                           Style="{StaticResource FieldLabel}"/>

                                <Border Grid.Row="2"
                                        Background="#0D0F15"
                                        BorderBrush="#292C37"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6">
                                    <WrapPanel x:Name="BookingHoursPanel"
                                               Orientation="Horizontal"
                                               FlowDirection="RightToLeft"/>
                                </Border>
                            </Grid>

                            <!-- DURATION -->
                            <Grid x:Name="BookingDurationStepPanel"
                                  Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="مدت رزرو"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBlock x:Name="BookingDurationStatusTextBlock"
                                               Grid.Column="1"
                                               Text=""
                                               FontSize="10"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="#0D0F15"
                                        BorderBrush="#292C37"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6">
                                    <WrapPanel x:Name="BookingDurationPanel"
                                               Orientation="Horizontal"
                                               FlowDirection="RightToLeft"/>
                                </Border>

                                <TextBlock Grid.Row="4"
                                           Text="زمان پایان بر اساس مدت انتخابی محاسبه می‌شود."
                                           Style="{StaticResource HintText}"/>
                            </Grid>

                            <!-- CUSTOMER -->
                            <Grid x:Name="BookingCustomerStepPanel"
                                  Grid.Row="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="مشخصات مشتری"
                                           Style="{StaticResource FieldLabel}"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نام یا شناسه مشتری"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox x:Name="BookingCustomerTextBox"
                                                 MaxLength="100"
                                                 ToolTip="نام یا شناسه مشتری"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="شماره موبایل"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox x:Name="BookingPhoneTextBox"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Left"
                                                 MaxLength="11"
                                                 InputMethod.IsInputMethodEnabled="False"
                                                 ToolTip="مثال: 09123456789"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="4">
                                    <TextBlock Text="یادداشت"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="BookingNoteTextBox"
                                             MinHeight="42"
                                             MaxHeight="58"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             MaxLength="1000"
                                             Padding="9,7"
                                             ToolTip="یادداشت اختیاری رزرو"/>
                                </StackPanel>
                            </Grid>

                            <!-- PRICE AND SUBMIT -->
                            <Grid Grid.Row="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="#24171D"
                                        BorderBrush="#512C35"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="مبلغ نهایی"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="BookingTotalTextBlock"
                                                   Grid.Column="1"
                                                   Text="۰ تومان"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#FF8992"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#191B24"
                                            BorderBrush="#30333F"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,6">
                                        <TextBlock x:Name="BookingFormStatusTextBlock"
                                                   Text="آماده ثبت رزرو"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <Button x:Name="CreateRealBookingButton"
                                            Grid.Column="2"
                                            Content="ثبت رزرو"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="112"
                                            MinHeight="38"
                                            Click="CreateRealBookingButton_Click"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT MAP AREA -->
                    <Grid x:Name="BookingSystemsStepPanel"
                          Grid.Column="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- MAP HEADER -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="نقشه سالن"
                                           Style="{StaticResource SectionHeading}"/>

                                <TextBlock Text="  ·  انتخاب مستقیم دستگاه‌ها"
                                           FontSize="10"
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="7,0,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{StaticResource GreenBgBrush}"
                                    BorderBrush="#32634F"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{StaticResource GreenBrush}"
                                             Margin="0,0,5,0"/>
                                    <TextBlock Text="نقشه فعال"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GreenBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- MAP HOST -->
                        <Border x:Name="InlineMapHost"
                                Grid.Row="2"
                                Visibility="Visible"
                                MinHeight="0"
                                Background="#0C0E14"
                                BorderBrush="#292D3A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6"
                                ClipToBounds="True"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>


                        <!-- LIVE CAPACITY -->
                        <Border Grid.Row="4"
        Background="#17151B"
        BorderBrush="#4B252D"
        BorderThickness="1"
        CornerRadius="9"
        Padding="9,7">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- CAPACITY TOTALS -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#321D24"
                    CornerRadius="6"
                    Padding="7,4"
                    VerticalAlignment="Center">
                                        <TextBlock Text="ظرفیت زنده"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#FF8992"/>
                                    </Border>

                                    <TextBlock x:Name="LiveCapacityTotalsTextBlock"
                       Grid.Column="2"
                       Text="در انتظار دریافت اطلاعات ظرفیت..."
                       FontSize="10"
                       Foreground="#E8D8DA"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
                                </Grid>

                                <!-- DYNAMIC SUMMARY -->
                                <WrapPanel x:Name="LiveCapacitySummaryPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    FlowDirection="RightToLeft"/>
                            </Grid>
                        </Border>

                        <!-- PRESERVED LEGACY BUTTON -->
                        <Button x:Name="OpenFloorPlanMapButton"
                                Visibility="Collapsed"
                                Content="نقشه سالن"
                                Click="OpenFloorPlanMapButton_Click"/>
                    </Grid>
                </Grid>

                <!-- WIZARD NAVIGATION -->
                <Grid x:Name="BookingWizardNavigationPanel"
                      Grid.Row="2"
                      Margin="0,8,0,0"
                      Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BookingBackButton"
                            Grid.Column="0"
                            Content="مرحله قبل"
                            Style="{StaticResource SecondaryButton}"
                            Click="BookingBackButton_Click"/>

                    <TextBlock Grid.Column="1"
                               Text="اطلاعات رزرو را بررسی کنید."
                               FontSize="11"
                               Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center"/>

                    <Button x:Name="BookingNextButton"
                            Grid.Column="2"
                            Content="ادامه"
                            Style="{StaticResource PrimaryButton}"
                            Click="BookingNextButton_Click"/>
                </Grid>

                <!-- FINAL REVIEW -->
                <Border x:Name="BookingReviewPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="#171923"
                        BorderBrush="#393047"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,8,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="بررسی و تأیید رزرو"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="اطلاعات رزرو را قبل از ثبت نهایی بررسی کنید."
                                       FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Background="#10121A"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <TextBlock x:Name="BookingReviewSummaryTextBlock"
                                       Text="خلاصه رزرو پس از تکمیل مراحل نمایش داده می‌شود."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BackToCustomerButton"
                                    Grid.Column="0"
                                    Content="ویرایش اطلاعات"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BackToCustomerButton_Click"/>

                            <TextBlock x:Name="BookingReviewStatusTextBlock"
                                       Grid.Column="1"
                                       Text="آماده ثبت رزرو"
                                       FontSize="11"
                                       Foreground="{StaticResource SubTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="8,0"/>

                            <Button Grid.Column="2"
                                    Content="ثبت رزرو"
                                    MinWidth="120"
                                    MinHeight="40"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="CreateRealBookingButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- HIDDEN CONTROLS USED BY CODE-BEHIND -->
        <Grid Visibility="Collapsed">
            <Image x:Name="GamenetLogoImage"/>

            <TextBlock x:Name="GamenetNameTextBlock"/>

            <Border x:Name="GamenetStatusBorder">
                <TextBlock x:Name="GamenetStatusTextBlock"/>
            </Border>

            <TextBlock x:Name="TodayBookingsTextBlock"/>
            <TextBlock x:Name="ActiveSystemsTextBlock"/>
            <TextBlock x:Name="PendingBookingsTextBlock"/>
            <TextBlock x:Name="ApiConnectionStatusTextBlock"/>
            <TextBlock x:Name="LastSuccessfulSyncTextBlock"/>

            <Button x:Name="RetrySyncButton"/>
        </Grid>

        <!-- LOADING OVERLAY -->
        <Grid x:Name="ManualLoadingOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="900"
              Visibility="Collapsed"
              Background="#D9101016"
              IsHitTestVisible="True">

            <Border Width="350"
                    MinHeight="165"
                    Padding="24"
                    CornerRadius="15"
                    Background="#191B24"
                    BorderBrush="#292D3A"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <ProgressBar Height="4"
                                 Width="230"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#30303B"
                                 BorderThickness="0"/>

                    <TextBlock x:Name="ManualLoadingTitleText"
                               Text="در حال آماده‌سازی رزرو"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,17,0,0"/>

                    <TextBlock x:Name="ManualLoadingDescriptionText"
                               Text="در حال دریافت اطلاعات از سرور لابیکس..."
                               FontSize="11"
                               Foreground="{StaticResource SubTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
