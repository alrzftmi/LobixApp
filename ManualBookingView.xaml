<UserControl x:Class="LobixApp.Views.ManualBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="#0D0E13"
             FontFamily="pack://application:,,,/Fonts/#Peyda">

    <UserControl.Resources>

        <!-- PALETTE -->
        <SolidColorBrush x:Key="PageBackground" Color="#0D0E13"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#111219"/>
        <SolidColorBrush x:Key="CardBackground" Color="#171820"/>
        <SolidColorBrush x:Key="CardBackgroundAlt" Color="#1D1F28"/>
        <SolidColorBrush x:Key="InputBackground" Color="#13151C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#292B36"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#DB3C45"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C92F39"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C191F"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#593039"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5A7B5"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#777B8B"/>

        <SolidColorBrush x:Key="SuccessBrush" Color="#55D6A0"/>
        <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#172B25"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E8B96A"/>
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#302719"/>
        <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#351D23"/>
        <SolidColorBrush x:Key="SelectionBrushColor" Color="#6BDB3C45"/>

        <FontFamily x:Key="PeydaFont">pack://application:,,,/Fonts/#Peyda</FontFamily>

        <!-- TEXT STYLES -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource PeydaFont}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F6F6F9"/>
        </Style>

        <Style x:Key="DescriptionText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B8BAC7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MicroLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <!-- BUTTONS -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource PeydaFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="FontSize" Value="13"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#20222C"/>
            <Setter Property="BorderBrush" Value="#343744"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="SidebarButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="13,13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- TEXT INPUTS -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource PeydaFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="#30333F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrushColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MinHeight" Value="44"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SURFACES -->
        <Style x:Key="SurfaceCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="StatCard"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="CalendarDayButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid Background="{StaticResource PageBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="26,24,26,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رزرو دستی"
                                   Style="{StaticResource PageTitleText}"/>

                        <TextBlock Text="ثبت و مدیریت رزروهای حضوری"
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#191A23"
                            BorderBrush="#2D303B"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,9"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">

                        <StackPanel Orientation="Horizontal">
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentSoftBrush}"
                                    Margin="0,0,9,0">

                                <TextBlock Text="●"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center"
                                        MaxWidth="180">

                                <TextBlock x:Name="OperatorNameTextBlock"
                                           Text="اپراتور"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="حساب اپراتور"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GAMENET CARD -->
                <Border Grid.Row="2"
                        Style="{StaticResource SurfaceCard}"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="70"
                                Height="70"
                                CornerRadius="14"
                                Background="#20222C"
                                BorderBrush="#343744"
                                BorderThickness="1"
                                Padding="8"
                                Margin="0,0,15,0">

                            <Image x:Name="GamenetLogoImage"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="گیمنت انتخاب‌شده"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="GamenetNameTextBlock"
                                       Text="در حال دریافت اطلاعات گیمنت..."
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="اطلاعات گیمنت از سرویس لابیکس دریافت می‌شود."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border x:Name="GamenetStatusBorder"
                                Grid.Column="2"
                                Background="#20222C"
                                BorderBrush="#343744"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,8"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">

                            <TextBlock x:Name="GamenetStatusTextBlock"
                                       Text="در حال بررسی"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- API CONNECTION AND SYNC STATUS -->
                <Border Grid.Row="3"
                        Visibility="Collapsed"
                        Background="#171820"
                        BorderBrush="#292B36"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,8,0,10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●"
                                           FontSize="12"
                                           Foreground="#E8B96A"
                                           Margin="0,0,7,0"/>

                                <TextBlock x:Name="ApiConnectionStatusTextBlock"
                                           Text="در حال بررسی اتصال به سرویس..."
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#E8B96A"/>
                            </StackPanel>

                            <TextBlock x:Name="LastSuccessfulSyncTextBlock"
                                       Text="هنوز همگام‌سازی موفقی انجام نشده است."
                                       FontSize="12"
                                       Foreground="#A5A7B5"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button x:Name="RetrySyncButton"
                                Grid.Column="1"
                                Content="تلاش مجدد"
                                Style="{StaticResource SecondaryButton}"
                                Padding="15,9"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- STATISTICS -->
                <Grid Grid.Row="4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="43"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="رزروهای امروز"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock x:Name="TodayBookingsTextBlock"
                                           Text="—"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Margin="0,7,0,0"/>

                                <TextBlock Text="رزروهای ثبت‌شده امروز"
                                           Style="{StaticResource MicroLabel}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Top">

                                <TextBlock Text="▤"
                                           FontSize="20"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="43"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="سیستم‌های گیمنت"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock x:Name="ActiveSystemsTextBlock"
                                           Text="—"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Margin="0,7,0,0"/>

                                <TextBlock Text="طبق اطلاعات دریافتی"
                                           Style="{StaticResource MicroLabel}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="#25243A"
                                    VerticalAlignment="Top">

                                <TextBlock Text="▦"
                                           FontSize="20"
                                           Foreground="#AAA5FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="43"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="رزروهای در انتظار"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock x:Name="PendingBookingsTextBlock"
                                           Text="—"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Margin="0,7,0,0"/>

                                <TextBlock Text="وضعیت رزروها"
                                           Style="{StaticResource MicroLabel}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{StaticResource WarningBackgroundBrush}"
                                    VerticalAlignment="Top">

                                <TextBlock Text="◷"
                                           FontSize="22"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BOOKING WORKSPACE -->
                <Border Grid.Row="6"
                        Style="{StaticResource SurfaceCard}"
                        Padding="12,10">

                    <Grid x:Name="BookingWorkspaceGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- FORM TITLE -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="ایجاد رزرو جدید"
                                           Style="{StaticResource SectionTitleText}"/>

                                <TextBlock x:Name="BookingWizardMessageTextBlock"
                                           Text="تاریخ، ساعت، سیستم و مشخصات مشتری را وارد کنید."
                                           Style="{StaticResource DescriptionText}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="{StaticResource AccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="11,7"
                                    VerticalAlignment="Center">

                                <TextBlock Text="رزرو حضوری"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9AA0"/>
                            </Border>
                        </Grid>

                        <!-- BOOKING CONTENT -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.92*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="1.08*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Column="0">

                                <!-- DATE -->
                                <Grid x:Name="BookingDateStepPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">

                                        <Border Width="25"
                                                Height="25"
                                                CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                Margin="0,0,8,0">

                                            <TextBlock Text="۱"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#FF9AA0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="تاریخ رزرو"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="PersianDateSelectorButton"
                                                Grid.Column="0"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalContentAlignment="Right"
                                                Padding="10,8">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="▦"
                                                           FontSize="17"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,0,10,0"/>

                                                <TextBlock x:Name="PersianDateTextBlock"
                                                           Grid.Column="1"
                                                           Text="در حال تعیین تاریخ"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </Button>

                                        <Button x:Name="PersianDateTodayButton"
                                                Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="امروز"
                                                Padding="17,10"/>
                                    </Grid>

                                    <!-- PERSIAN CALENDAR -->
                                    <Popup x:Name="PersianCalendarPopup"
                                           PlacementTarget="{Binding ElementName=PersianDateSelectorButton}"
                                           Placement="Bottom"
                                           HorizontalOffset="-170"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">

                                        <Border Width="310"
                                                Margin="0,8,0,0"
                                                Background="#191A23"
                                                BorderBrush="#373946"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="14">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="13"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button x:Name="PersianCalendarPreviousButton"
                                                            Grid.Column="0"
                                                            Content="‹"
                                                            FontSize="20"
                                                            Padding="0"
                                                            Height="34"/>

                                                    <TextBlock x:Name="PersianCalendarMonthTextBlock"
                                                               Grid.Column="1"
                                                               Text="مهر ۱۴۰۵"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"/>

                                                    <Button x:Name="PersianCalendarNextButton"
                                                            Grid.Column="2"
                                                            Content="›"
                                                            FontSize="20"
                                                            Padding="0"
                                                            Height="34"/>
                                                </Grid>

                                                <UniformGrid Grid.Row="2"
                                                             Columns="7"
                                                             Margin="0,0,0,5">

                                                    <TextBlock Text="ش"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Text="ی"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Text="د"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Text="س"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Text="چ"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Text="پ"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>

                                                    <TextBlock Text="ج"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </UniformGrid>

                                                <UniformGrid x:Name="PersianCalendarDaysGrid"
                                                             Grid.Row="4"
                                                             Columns="7"/>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- START TIME -->
                                <Grid x:Name="BookingHourStepPanel"
                                      Margin="0,12,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">

                                        <Border Width="25"
                                                Height="25"
                                                CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                Margin="0,0,8,0">

                                            <TextBlock Text="۲"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#FF9AA0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- FIXED: TextBlock instead of invalid Text -->
                                        <TextBlock Text="زمان شروع"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2"
                                               Text="زمان شروع را با فاصله‌های ۵ دقیقه‌ای انتخاب کنید."
                                               Style="{StaticResource DescriptionText}"/>

                                    <Border Grid.Row="4"
                                            Background="#12141A"
                                            BorderBrush="#292C37"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="10">

                                        <WrapPanel x:Name="BookingHoursPanel"
                                                   Orientation="Horizontal"
                                                   FlowDirection="RightToLeft"/>
                                    </Border>
                                </Grid>

                                <!-- END TIME -->
                                <Grid x:Name="BookingDurationStepPanel"
                                      Margin="0,12,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">

                                        <Border Width="25"
                                                Height="25"
                                                CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                Margin="0,0,8,0">

                                            <TextBlock Text="۳"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#FF9AA0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- FIXED: TextBlock instead of invalid Text -->
                                        <TextBlock Text="زمان پایان"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <TextBlock x:Name="BookingDurationStatusTextBlock"
                                               Grid.Row="2"
                                               Text="زمان پایان را با فاصله‌های ۵ دقیقه‌ای انتخاب کنید."
                                               Style="{StaticResource DescriptionText}"/>

                                    <Border Grid.Row="4"
                                            Background="#12141A"
                                            BorderBrush="#292C37"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            Padding="10">

                                        <WrapPanel x:Name="BookingDurationPanel"
                                                   Orientation="Horizontal"
                                                   FlowDirection="RightToLeft"/>
                                    </Border>
                                </Grid>

                                <!-- CUSTOMER DETAILS -->
                                <Grid x:Name="BookingCustomerStepPanel"
                                      Margin="0,22,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">

                                        <Border Width="25"
                                                Height="25"
                                                CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                Margin="0,0,8,0">

                                            <TextBlock Text="۵"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#FF9AA0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="اطلاعات مشتری"
                                                   Style="{StaticResource SectionTitleText}"/>
                                    </StackPanel>

                                    <!-- NAME AND PHONE -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="نام مشتری"
                                                       Style="{StaticResource FieldLabel}"/>

                                            <TextBox x:Name="BookingCustomerTextBox"
                                                     MaxLength="100"
                                                     ToolTip="نام یا نام نمایشی مشتری"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="شماره موبایل"
                                                       Style="{StaticResource FieldLabel}"/>

                                            <TextBox x:Name="BookingPhoneTextBox"
                                                     FlowDirection="LeftToRight"
                                                     TextAlignment="Left"
                                                     MaxLength="11"
                                                     InputMethod.IsInputMethodEnabled="False"
                                                     ToolTip="مثال: 09123456789"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CUSTOMER ID -->
                                    <StackPanel Grid.Row="4">
                                        <TextBlock Text="شناسه مشتری (اختیاری)"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="BookingCustomerIdTextBox"
                                                 MaxLength="100"
                                                 ToolTip="شناسه داخلی مشتری"/>
                                    </StackPanel>

                                    <!-- NOTE -->
                                    <StackPanel Grid.Row="6">
                                        <TextBlock Text="یادداشت رزرو (اختیاری)"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="BookingNoteTextBox"
                                                 MinHeight="48"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 MaxLength="1000"
                                                 Padding="12,10"
                                                 ToolTip="توضیحات تکمیلی رزرو"/>
                                    </StackPanel>

                                    <!-- PRICE SUMMARY -->
                                    <Border Grid.Row="8"
                                            Visibility="Visible"
                                            Background="#21171D"
                                            BorderBrush="#4B2931"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="17,15">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="مبلغ نهایی رزرو"
                                                           FontSize="13"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="مبلغ بر اساس سیستم‌ها، تعداد و مدت انتخاب‌شده محاسبه می‌شود."
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <TextBlock x:Name="BookingTotalTextBlock"
                                                       Grid.Column="1"
                                                       Text="۰ تومان"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       Foreground="#FF858D"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- STATUS AND SUBMIT -->
                                    <Grid Grid.Row="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#151720"
                                                BorderBrush="#2A2D38"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="12,10"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">

                                            <TextBlock x:Name="BookingFormStatusTextBlock"
                                                       Text="در حال دریافت اطلاعات گیمنت..."
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>

                                        <Button x:Name="CreateRealBookingButton"
                                                Grid.Column="1"
                                                Content="ثبت رزرو"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="138"
                                                MinHeight="42"
                                                Click="CreateRealBookingButton_Click"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <!-- RIGHT COLUMN -->
                            <StackPanel Grid.Column="2">

                                <!-- SYSTEMS -->
                                <Grid x:Name="BookingSystemsStepPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="25"
                                                    Height="25"
                                                    CornerRadius="8"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    Margin="0,0,8,0">

                                                <TextBlock Text="۴"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#FF9AA0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="انتخاب سیستم از نقشه سالن"
                                                       FontSize="13"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="انتخاب و لغو انتخاب با کلیک روی دستگاه‌ها"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Vertical">

                                        <TextBlock Text="پس از انتخاب تاریخ و ساعت، دستگاه‌های آزاد را مستقیماً روی نقشه سالن انتخاب کنید."
                                                   Style="{StaticResource DescriptionText}"/>

                                        <Button x:Name="OpenFloorPlanMapButton"
                                                Visibility="Collapsed"
                                                Content="نقشه سالن"
                                                Click="OpenFloorPlanMapButton_Click"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,2"
                                                Padding="10,5"
                                                Foreground="#FFFFFF"
                                                Background="#8E2634"
                                                BorderBrush="#C64A5A"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>

                                        <Border x:Name="InlineMapHost"
                                                Visibility="Visible"
                                                Height="480"
                                                MinHeight="420"
                                                MaxHeight="560"
                                                Margin="0,8,0,0"
                                                Background="#11131A"
                                                BorderBrush="#343744"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6"/>
                                    </StackPanel>

                                    <!-- LIVE SYSTEM CAPACITY -->
                                    <Border Grid.Row="6"
                                            Background="#151720"
                                            BorderBrush="#393047"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10"
                                            Margin="0,2,0,2">

                                        <StackPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="وضعیت زنده ظرفیت سیستم‌ها"
                                                               FontFamily="{StaticResource PeydaFont}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="#F4F1FA"/>

                                                    <TextBlock Text="بررسی ظرفیت در ساعت انتخاب‌شده"
                                                               FontFamily="{StaticResource PeydaFont}"
                                                               FontSize="12"
                                                               Foreground="#A5A0B5"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="#192D28"
                                                        BorderBrush="#32634F"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,5"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="●"
                                                                   FontFamily="{StaticResource PeydaFont}"
                                                                   FontSize="11"
                                                                   Foreground="#65E0A5"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,5,0"/>

                                                        <TextBlock Text="LIVE"
                                                                   FontFamily="{StaticResource PeydaFont}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#65E0A5"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Background="#201B2B"
                                                    BorderBrush="#443354"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8"
                                                    Margin="0,0,0,8">

                                                <TextBlock x:Name="LiveCapacityTotalsTextBlock"
                                                           Text="در انتظار دریافت اطلاعات ظرفیت..."
                                                           FontFamily="{StaticResource PeydaFont}"
                                                           Foreground="#D9C8FF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           LineHeight="23"/>
                                            </Border>

                                            <StackPanel x:Name="LiveCapacitySummaryPanel"
                                                        Orientation="Vertical"
                                                        FlowDirection="RightToLeft"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- OPTIONAL GAME -->
                                    <StackPanel Grid.Row="8">
                                        <TextBlock Text="بازی موردنظر (اختیاری)"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,6"/>

                                        <TextBox x:Name="BookingGameTextBox"
                                                 MaxLength="120"
                                                 ToolTip="نام بازی انتخابی مشتری"/>

                                        <TextBlock Text="نام بازی در یادداشت رزرو ذخیره می‌شود."
                                                   Style="{StaticResource MicroLabel}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- WIZARD NAVIGATION -->
                        <Grid x:Name="BookingWizardNavigationPanel"
                              Grid.Row="2"
                              Margin="0,18,0,0"
                              Visibility="Collapsed">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BookingBackButton"
                                    Grid.Column="0"
                                    Content="→ مرحله قبل"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="125"
                                    MinHeight="44"
                                    Click="BookingBackButton_Click"/>

                            <TextBlock Grid.Column="1"
                                       Text="اطلاعات هر مرحله را بررسی کنید و سپس ادامه دهید."
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>

                            <Button x:Name="BookingNextButton"
                                    Grid.Column="2"
                                    Content="ادامه ←"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="145"
                                    MinHeight="44"
                                    Click="BookingNextButton_Click"/>
                        </Grid>

                        <!-- FINAL REVIEW -->
                        <Border x:Name="BookingReviewPanel"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Margin="0,18,0,0"
                                Background="#151720"
                                BorderBrush="#393047"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18">

                            <StackPanel>
                                <TextBlock Text="۶. بررسی و تأیید نهایی"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="قبل از ثبت، تاریخ، زمان، سیستم‌ها و مبلغ را بررسی کنید."
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,5,0,14"/>

                                <Border Background="#101117"
                                        BorderBrush="#292B36"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">

                                    <TextBlock x:Name="BookingReviewSummaryTextBlock"
                                               Text="خلاصه رزرو پس از تکمیل مراحل نمایش داده می‌شود."
                                               FontSize="13"
                                               LineHeight="25"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="در صورت وارد کردن نام بازی، این اطلاعات در یادداشت رزرو ثبت می‌شود."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,10,0,0"/>

                                <Border Margin="0,12,0,0"
                                        Padding="12,10"
                                        CornerRadius="8"
                                        Background="#20151A22"
                                        BorderBrush="#3A3544"
                                        BorderThickness="1">

                                    <TextBlock x:Name="BookingReviewStatusTextBlock"
                                               Text="آماده ثبت رزرو؛ خطاها و نتیجه ثبت در همین قسمت نمایش داده می‌شوند."
                                               Foreground="LightGray"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BackToCustomerButton"
                                            Grid.Column="0"
                                            Content="→ ویرایش اطلاعات"
                                            Style="{StaticResource SecondaryButton}"
                                            MinHeight="46"
                                            Click="BackToCustomerButton_Click"/>

                                    <TextBlock Grid.Column="1"
                                               Text="با تأیید، ظرفیت دوباره از سرور بررسی می‌شود."
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="10,0"/>

                                    <Button Grid.Column="2"
                                            Content="تأیید و ثبت رزرو"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="170"
                                            MinHeight="46"
                                            Click="CreateRealBookingButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- LOADING OVERLAY -->
        <Grid x:Name="ManualLoadingOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="900"
              Visibility="Collapsed"
              Background="#D9101016"
              IsHitTestVisible="True">

            <Border Width="390"
                    MinHeight="190"
                    Padding="28"
                    CornerRadius="18"
                    Background="#191922"
                    BorderBrush="#363644"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <ProgressBar Height="4"
                                 Width="250"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#30303B"
                                 BorderThickness="0"/>

                    <TextBlock x:Name="ManualLoadingTitleText"
                               Text="در حال آماده‌سازی رزروها"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>

                    <TextBlock x:Name="ManualLoadingDescriptionText"
                               Text="در حال دریافت اطلاعات از سرور لابیکس..."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
