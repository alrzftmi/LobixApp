<UserControl x:Class="LobixApp.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="#0D0E13"
             Foreground="#F4F4F7"
             FontFamily="pack://application:,,,/Fonts/#Peyda">

    <UserControl.Resources>

        <!-- ===================== COLOR PALETTE ===================== -->

        <SolidColorBrush x:Key="PageBackground" Color="#0D0E13"/>
        <SolidColorBrush x:Key="CardBackground" Color="#151720"/>
        <SolidColorBrush x:Key="CardElevated" Color="#1C1F29"/>
        <SolidColorBrush x:Key="SoftBackground" Color="#1C1F29"/>
        <SolidColorBrush x:Key="InputBackground" Color="#101219"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#DB3C45"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C92F39"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#321D24"/>

        <SolidColorBrush x:Key="DarkText" Color="#F4F4F7"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#A5A7B5"/>
        <SolidColorBrush x:Key="MutedText" Color="#747887"/>

        <SolidColorBrush x:Key="BorderColor" Color="#2B2E3A"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2B2E3A"/>

        <SolidColorBrush x:Key="SuccessBackground" Color="#172B25"/>
        <SolidColorBrush x:Key="SuccessText" Color="#55D6A0"/>

        <SolidColorBrush x:Key="WarningBackground" Color="#33291D"/>
        <SolidColorBrush x:Key="WarningText" Color="#E8B96A"/>

        <SolidColorBrush x:Key="DangerBackground" Color="#321D24"/>
        <SolidColorBrush x:Key="DangerText" Color="#FF8992"/>

        <SolidColorBrush x:Key="OnlineReservationColor" Color="#DB3C45"/>
        <SolidColorBrush x:Key="OnlineReservationBackground" Color="#321D24"/>

        <SolidColorBrush x:Key="ManualReservationColor" Color="#E8B96A"/>
        <SolidColorBrush x:Key="ManualReservationBackground" Color="#33291D"/>

        <SolidColorBrush x:Key="LoadingOverlayBackground" Color="#D9101116"/>

        <FontFamily x:Key="Peyda">pack://application:,,,/Fonts/#Peyda</FontFamily>

        <!-- ===================== GLOBAL TYPOGRAPHY ===================== -->

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <!-- ===================== BUTTON STYLES ===================== -->

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Background" Value="{StaticResource SoftBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252936"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#444958"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303441"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تمام دکمه‌ها به صورت پیش‌فرض گرد و تیره هستند -->
        <Style TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}"/>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="PrimaryBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder"
                                        Property="Opacity"
                                        Value="0.84"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder"
                                        Property="Opacity"
                                        Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="DateFilterButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style x:Key="StatusFilterButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="11,7"/>
        </Style>

        <!-- ===================== TYPOGRAPHY STYLES ===================== -->

        <Style x:Key="SectionLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
        </Style>

        <Style x:Key="MutedLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        </Style>

        <Style x:Key="LegendTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MutedLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatCardStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="15,11"/>
        </Style>

        <!-- ===================== TEXTBOX ===================== -->

        <Style x:Key="DarkTextBoxStyle"
               TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ===================== COMBOBOX ITEM ===================== -->

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#F4F4F7"/>
            <Setter Property="Background" Value="#1C1F29"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="3,1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#302027"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#C92F39"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== COMBOBOX ===================== -->

        <Style x:Key="DarkComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="{StaticResource Peyda}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>

                            <!-- جدا کردن فضای متن از دکمه فلش؛ فلش همیشه داخل کادر و سمت راست -->
                            <Grid Margin="1" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="SelectionPresenter"
                                    Grid.Column="0"
                                    FlowDirection="RightToLeft"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    IsHitTestVisible="False"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         FlowDirection="RightToLeft"
                                         Margin="{TemplateBinding Padding}"
                                         Background="Transparent"
                                         Foreground="{TemplateBinding Foreground}"
                                         BorderThickness="0"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         FontSize="{TemplateBinding FontSize}"
                                         VerticalContentAlignment="Center"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                <ToggleButton Grid.Column="1"
                                              Width="36"
                                              MinWidth="36"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Focusable="False"
                                              IsTabStop="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="#252936"
                                              BorderBrush="#393C49"
                                              BorderThickness="1,0,0,0"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="ArrowButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="0,7,7,0">
                                                <Path x:Name="Arrow"
                                                      Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#F4F4F7"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ArrowButtonBorder"
                                                            Property="Background"
                                                            Value="#DB3C45"/>
                                                    <Setter TargetName="Arrow"
                                                            Property="Stroke"
                                                            Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ArrowButtonBorder"
                                                            Property="Background"
                                                            Value="#C92F39"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ArrowButtonBorder"
                                                            Property="Opacity"
                                                            Value="0.45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#191B24"
                                        BorderBrush="#393C49"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer
                                        CanContentScroll="True"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#454958"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionPresenter"
                                        Property="Visibility"
                                        Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource DarkComboBoxStyle}"/>

        <!-- ===================== SCROLLBAR ===================== -->

        <Style x:Key="DarkScrollBarStyle"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#151720"/>
            <Setter Property="Foreground" Value="#DB3C45"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="MinWidth" Value="11"/>
            <Setter Property="MinHeight" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#151720">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="ScrollBar.PageUpCommand"
                                                  Background="#151720"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Background="#DB3C45"
                                           MinHeight="28"
                                           MinWidth="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#E64B55"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#C22E39"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="ScrollBar.PageDownCommand"
                                                  Background="#151720"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="11"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="11"/>
                                <Setter TargetName="PART_Track"
                                        Property="IsDirectionReversed"
                                        Value="False"/>
                                <Setter TargetName="DecreaseButton"
                                        Property="Command"
                                        Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="IncreaseButton"
                                        Property="Command"
                                        Value="ScrollBar.PageRightCommand"/>
                            </Trigger>

                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="11"/>
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="MinWidth" Value="11"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter TargetName="PART_Track"
                                        Property="IsDirectionReversed"
                                        Value="True"/>
                                <Setter TargetName="DecreaseButton"
                                        Property="Command"
                                        Value="ScrollBar.PageUpCommand"/>
                                <Setter TargetName="IncreaseButton"
                                        Property="Command"
                                        Value="ScrollBar.PageDownCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ===================== MAIN PAGE ===================== -->

    <Grid Background="{StaticResource PageBackground}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">

            <StackPanel Margin="18">

                <!-- PAGE HEADER -->

                <Border Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20,15">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="مدیریت رزروها"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DarkText}"/>

                            <TextBlock Text="نمای یکپارچه رزروها، ظرفیت سالن و برنامه زمانی گیمنت"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}"/>

                            <TextBlock x:Name="SyncStatusTextBlock"
                                       Text="در انتظار دریافت اطلاعات"
                                       Margin="0,7,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource WarningText}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="RefreshReservationsButton"
                                    Content="↻  بروزرسانی"
                                    MinWidth="112"
                                    Height="40"
                                    Margin="0,0,8,0"
                                    ToolTip="دریافت مجدد اطلاعات رزروها از سرور"
                                    Style="{StaticResource BaseButtonStyle}"/>

                            <Button x:Name="NewReservationButton"
                                    Content="+  ثبت رزرو جدید"
                                    MinWidth="142"
                                    Height="40"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DATE FILTERS -->

                <Border Margin="0,12,0,0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="15,12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="تاریخ"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabelStyle}"/>

                        <WrapPanel Grid.Column="1"
                                   VerticalAlignment="Center">

                            <Button x:Name="TodayDateButton"
                                    Content="امروز"
                                    Style="{StaticResource DateFilterButton}"
                                    Click="TodayButton_Click"/>

                            <Button x:Name="TomorrowDateButton"
                                    Content="فردا"
                                    Style="{StaticResource DateFilterButton}"
                                    Click="TomorrowButton_Click"/>

                            <Button x:Name="DayAfterTomorrowDateButton"
                                    Content="پس‌فردا"
                                    Style="{StaticResource DateFilterButton}"
                                    Click="DayAfterTomorrowButton_Click"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">

                            <Button x:Name="PreviousDayButton"
                                    Content="‹"
                                    Width="34"
                                    Height="34"
                                    ToolTip="روز قبل"
                                    Style="{StaticResource SmallActionButtonStyle}"/>

                            <Button x:Name="NextDayButton"
                                    Content="›"
                                    Width="34"
                                    Height="34"
                                    Margin="5,0,0,0"
                                    ToolTip="روز بعد"
                                    Style="{StaticResource SmallActionButtonStyle}"/>

                            <Button x:Name="DatePickerButton"
                                    Content="▦  تقویم شمسی"
                                    Height="34"
                                    Margin="5,0,0,0"
                                    Style="{StaticResource SmallActionButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SEARCH -->

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="44"
                            Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="10">

                        <Grid>
                            <TextBlock Text="⌕"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="23"
                                       Foreground="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,13,3"
                                       IsHitTestVisible="False"/>

                            <TextBox x:Name="SearchTextBox"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Margin="42,0,45,0"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource Peyda}"
                                     FontSize="12"
                                     Foreground="{StaticResource DarkText}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     SelectionBrush="{StaticResource AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"/>

                            <TextBlock x:Name="SearchPlaceholderTextBlock"
                                       Text="جستجو در نام مشتری، شماره موبایل یا کد رزرو..."
                                       Margin="42,0,45,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedText}"
                                       IsHitTestVisible="False"/>

                            <Button x:Name="ClearSearchButton"
                                    Content="×"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="7,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource SecondaryText}"
                                    FontSize="20"
                                    Padding="0"
                                    Visibility="Collapsed"
                                    ToolTip="پاک کردن جست‌وجو"
                                    Click="ClearSearchButton_Click"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Content="جستجو"
                            Width="88"
                            Height="44"
                            Margin="8,0,0,0"
                            Click="SearchButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

                <!-- QUICK STATISTICS -->

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource StatCardStyle}"
                            Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="کل رزروها"
                                           Style="{StaticResource MutedLabelStyle}"/>

                                <TextBlock x:Name="TotalReservationsText"
                                           Text="—"
                                           Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="10"
                                    Background="#30313D"
                                    VerticalAlignment="Center">
                                <TextBlock Text="▤"
                                           FontSize="18"
                                           Foreground="#D2D5E0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource StatCardStyle}"
                            Margin="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="در انتظار تأیید"
                                           Style="{StaticResource MutedLabelStyle}"/>

                                <TextBlock x:Name="PendingReservationsText"
                                           Text="—"
                                           Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningText}"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="10"
                                    Background="{StaticResource WarningBackground}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="◷"
                                           FontSize="19"
                                           Foreground="{StaticResource WarningText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource StatCardStyle}"
                            Margin="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تأییدشده"
                                           Style="{StaticResource MutedLabelStyle}"/>

                                <TextBlock x:Name="ConfirmedReservationsText"
                                           Text="—"
                                           Margin="0,3,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessText}"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="10"
                                    Background="{StaticResource SuccessBackground}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✓"
                                           FontSize="18"
                                           Foreground="{StaticResource SuccessText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource StatCardStyle}"
                            Margin="6,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تاریخ انتخاب‌شده"
                                           Style="{StaticResource MutedLabelStyle}"/>

                                <TextBlock x:Name="SelectedDateText"
                                           Text="امروز"
                                           Margin="0,5,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="10"
                                    Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="▦"
                                           FontSize="18"
                                           Foreground="#F07B83"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MAIN WORK AREA -->

                <Grid Height="490"
                      Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.35*" MinWidth="420"/>
                        <ColumnDefinition Width="0.95*" MinWidth="245"/>
                    </Grid.ColumnDefinitions>

                    <!-- LIVE MAP -->

                    <Border Grid.Column="0"
                            Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="2,0,2,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="نقشه زنده سالن"
                                               FontSize="15"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="FloorMapSummaryText"
                                               Text="در حال بارگذاری نقشه..."
                                               Margin="0,3,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryText}"/>
                                </StackPanel>

                                <WrapPanel Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left">

                                    <ComboBox x:Name="FloorMapFloorCombo"
                                              Width="112"
                                              Height="30"
                                              Margin="0,0,6,0"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="FloorMapFloorCombo_SelectionChanged"
                                              ToolTip="انتخاب طبقه نقشه"/>

                                    <Button x:Name="RefreshFloorMapButton"
                                            Content="↻ نقشه"
                                            Height="30"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="RefreshFloorMapButton_Click"/>

                                    <Button Content="⛶ تمام‌صفحه"
                                            Height="30"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="FullscreenFloorMapButton_Click"/>

                                    <Button Content="−"
                                            Width="30"
                                            Height="30"
                                            ToolTip="کوچک‌نمایی نقشه"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="MapZoomOutButton_Click"/>

                                    <Button Content="۱۰۰٪"
                                            Width="48"
                                            Height="30"
                                            ToolTip="بازنشانی بزرگ‌نمایی"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="MapZoomResetButton_Click"/>

                                    <Button Content="+"
                                            Width="30"
                                            Height="30"
                                            ToolTip="بزرگ‌نمایی نقشه"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="MapZoomInButton_Click"/>

                                    <Button x:Name="LiveMapMultiSelectButton"
                                            Content="انتخاب چند سیستم"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="LiveMapMultiSelectButton_Click"/>

                                    <Button x:Name="CancelGuidedBookingButton"
                                            Content="لغو ثبت رزرو"
                                            Height="30"
                                            Visibility="Collapsed"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            Click="CancelGuidedBookingButton_Click"/>
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#10121A"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">

                                <ScrollViewer x:Name="LiveMapScrollViewer"
              FlowDirection="LeftToRight"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              CanContentScroll="False"
              PanningMode="Both"
              Background="#10121A"
              PreviewMouseWheel="LiveMapScrollViewer_PreviewMouseWheel"
              SizeChanged="LiveMapScrollViewer_SizeChanged">
                                    <Canvas x:Name="LiveFloorMapCanvas"
            FlowDirection="LeftToRight"
            Width="1600"
            Height="1000"
            Background="#10121A"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- OPERATOR CONTEXT PANEL -->

                    <Border Grid.Column="1"
                            Margin="10,0,0,0"
                            Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="15">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <StackPanel>

                                <TextBlock Text="راهنمای کار اپراتور"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock Text="وضعیت‌ها و عملیات سریع"
                                           Margin="0,3,0,14"
                                           Style="{StaticResource MutedLabelStyle}"/>

                                <!-- SYSTEM STATUS -->

                                <Border Background="{StaticResource CardElevated}"
                                        CornerRadius="11"
                                        Padding="12">

                                    <StackPanel>
                                        <TextBlock Text="وضعیت سیستم‌ها"
                                                   Style="{StaticResource SectionLabelStyle}"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,10">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="5"
                                                    Background="#35B779"
                                                    Margin="0,0,8,0"/>

                                            <TextBlock Text="آزاد برای رزرو"
                                                       Style="{StaticResource LegendTextStyle}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,10">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="5"
                                                    Background="#DB3C45"
                                                    Margin="0,0,8,0"/>

                                            <TextBlock Text="دارای رزرو"
                                                       Style="{StaticResource LegendTextStyle}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="5"
                                                    Background="#858B9B"
                                                    Margin="0,0,8,0"/>

                                            <TextBlock Text="غیرفعال در چیدمان"
                                                       Style="{StaticResource LegendTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- RESERVATION TYPE -->

                                <Border Background="{StaticResource CardElevated}"
                                        CornerRadius="11"
                                        Padding="12"
                                        Margin="0,10,0,0">

                                    <StackPanel>
                                        <TextBlock Text="نوع ثبت رزرو"
                                                   Style="{StaticResource SectionLabelStyle}"
                                                   Margin="0,0,0,11"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,9">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="3"
                                                    Background="{StaticResource OnlineReservationColor}"
                                                    Margin="0,0,8,0"/>

                                            <TextBlock Text="رزرو آنلاین"
                                                       Style="{StaticResource LegendTextStyle}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="3"
                                                    Background="{StaticResource ManualReservationColor}"
                                                    Margin="0,0,8,0"/>

                                            <TextBlock Text="رزرو دستی اپراتور"
                                                       Style="{StaticResource LegendTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- OPERATOR TIP -->

                                <Border Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="#4B252D"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="12"
                                        Margin="0,10,0,0">

                                    <StackPanel>
                                        <TextBlock Text="نکته کاربردی"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F08A91"/>

                                        <TextBlock Text="برای مشاهده جزئیات روی سیستم کلیک کن. برای ثبت گروهی، «انتخاب چند سیستم» را فعال کن و سیستم‌های آزاد را روی نقشه انتخاب کن."
                                                   Margin="0,6,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource SecondaryText}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="FullscreenTimelineButton"
                                        Content="☷  نمایش بزرگ جدول رزروها"
                                        MinHeight="43"
                                        Margin="0,12,0,0"
                                        Padding="10,8"
                                        FontFamily="{StaticResource Peyda}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Background="{StaticResource AccentBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="FullscreenTimelineButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- RESERVATION TIMELINE -->

                <Border Margin="0,12,0,0"
                        Height="385"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="2,0,2,9">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="جدول زمان‌بندی رزروها"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock Text="نمای ساعتی رزرو سیستم‌ها در روز انتخاب‌شده"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource MutedLabelStyle}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="برای دیدن جزئیات، روی رزرو کلیک کن"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedLabelStyle}"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#10121A"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ScrollViewer x:Name="TimelineHeaderScrollViewer"
                                              Grid.Row="0"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              IsHitTestVisible="False"
                                              Background="#151720">

                                    <Canvas x:Name="TimelineStickyHeaderCanvas"
                                            Height="42"
                                            Width="1900"
                                            Background="#151720"/>
                                </ScrollViewer>

                                <ScrollViewer x:Name="TimelineScrollViewer"
                                              Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              SizeChanged="TimelineScrollViewer_SizeChanged"
                                              ScrollChanged="TimelineScrollViewer_ScrollChanged"
                                              CanContentScroll="False"
                                              PanningMode="Both"
                                              Background="#10121A">

                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource DarkScrollBarStyle}"/>
                                    </ScrollViewer.Resources>

                                    <Canvas x:Name="TimelineCanvas"
                                            Width="1900"
                                            Height="500"
                                            Background="#10121A"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== LOADING OVERLAY ===================== -->

        <Grid x:Name="LoadingOverlay"
              Panel.ZIndex="5000"
              Visibility="Collapsed"
              Background="{StaticResource LoadingOverlayBackground}">

            <Border Width="350"
                    MinHeight="205"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Grid Width="56"
                          Height="56"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,18">

                        <Ellipse Width="50"
                                 Height="50"
                                 Stroke="#292D3A"
                                 StrokeThickness="5"/>

                        <Ellipse Width="50"
                                 Height="50"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="5"
                                 StrokeDashArray="1 2"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5">

                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="LoadingSpinnerRotation"/>
                            </Ellipse.RenderTransform>

                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="RenderTransform.Angle"
                                                From="0"
                                                To="360"
                                                Duration="0:0:0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="لطفاً صبر کنید"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="LoadingText"
                               Text="در حال دریافت اطلاعات رزروها..."
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="اطلاعات در حال همگام‌سازی با سرور است"
                               Margin="0,11,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
