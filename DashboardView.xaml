<UserControl x:Class="LobixApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#0C0D12"
             FontFamily="pack://application:,,,/Fonts/#Peyda"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Card" Color="#171923"/>
        <SolidColorBrush x:Key="CardAlt" Color="#1D1F2B"/>
        <SolidColorBrush x:Key="Line" Color="#303243"/>
        <SolidColorBrush x:Key="Muted" Color="#A4A7BA"/>
        <SolidColorBrush x:Key="TextMain" Color="#F5F5FA"/>
        <SolidColorBrush x:Key="Accent" Color="#DB3C45"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Peyda"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#222331"/>
            <Setter Property="Foreground" Value="#F5F5FA"/>
            <Setter Property="BorderBrush" Value="#393B50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Peyda"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2B1B22"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#593039"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,26,30,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="مرکز فرمان لابیکس" FontSize="29" FontWeight="Bold" Width="784"/>
                    <TextBlock Text="وضعیت گیمنت، دسترسی سریع و ابزارهای روزمره اپراتور" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#2B1B22" BorderBrush="#543039" BorderThickness="1" CornerRadius="10" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#DB3C45" Margin="0,0,8,0"/>
                        <TextBlock Text="پنل اپراتور" Foreground="#FFB1B5" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#191A26" BorderBrush="#393449" BorderThickness="1" CornerRadius="20" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="خوش آمدی" FontSize="13" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="GamenetNameTextBlock" Text="گیمنت" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="OperatorNameTextBlock" Text="اپراتور" FontSize="14" Foreground="#B5B6C8" Margin="0,7,0,0"/>
                        <TextBlock Text="همه‌چیز برای مدیریت سریع‌تر رزروها در دسترس توست." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,15,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,0,0,0">
                        <Border x:Name="GamenetStatusBorder" Background="#172B25" BorderBrush="#285342" BorderThickness="1" CornerRadius="12" Padding="18,11">
                            <TextBlock x:Name="GamenetStatusTextBlock" Text="فعال" Foreground="#55D6A0" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <TextBlock Text="وضعیت سرویس" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="4"
             Columns="3"
             VerticalAlignment="Center"
             HorizontalAlignment="Stretch">

                <!-- سیستم‌های ثبت شده -->
                <Border Background="#171923"
            BorderBrush="#303243"
            BorderThickness="1"
            CornerRadius="15"
            Padding="16"
            Margin="6"
            Height="116">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                       Foreground="{StaticResource Muted}">
                <Run FlowDirection="RightToLeft"
                     Language="fa-ir"
                     Text="سیستم های ثبت شده"/>
                        </TextBlock>
                        <TextBlock x:Name="SystemsCountText"
                       Text="—"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,2"/>
                        <TextBlock Text="بر اساس اطلاعات سایت"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- رزروهای امروز -->
                <Border Background="#171923"
            BorderBrush="#303243"
            BorderThickness="1"
            CornerRadius="15"
            Padding="16"
            Margin="6"
            Height="116">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="رزروهای امروز"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="TodayBookingsText"
                       Text="—"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,2"/>
                        <TextBlock Text="آنلاین + حضوری"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- رزروهای ۷ روز آینده -->
                <Border Background="#171923"
            BorderBrush="#303243"
            BorderThickness="1"
            CornerRadius="15"
            Padding="16"
            Margin="6"
            Height="116">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="رزروهای ۷ روز آینده"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="UpcomingBookingsText"
                       Text="—"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,2"/>
                        <TextBlock Text="دریافت‌شده از سرور"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- رزرو دستی امروز -->
                <Border Background="#171923"
            BorderBrush="#303243"
            BorderThickness="1"
            CornerRadius="15"
            Padding="16"
            Margin="6"
            Height="116">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="رزرو دستی امروز"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="ManualTodayText"
                       Text="—"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,2"/>
                        <TextBlock Text="ثبت‌شده توسط اپراتور"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- رزرو آنلاین امروز -->
                <Border Background="#171923"
            BorderBrush="#303243"
            BorderThickness="1"
            CornerRadius="15"
            Padding="16"
            Margin="6"
            Height="116">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="رزرو آنلاین امروز"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="OnlineTodayText"
                       Text="—"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,2"/>
                        <TextBlock Text="ثبت‌شده از وب‌سایت"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- آخرین همگام‌سازی -->
                <Border Background="#171923"
            BorderBrush="#303243"
            BorderThickness="1"
            CornerRadius="15"
            Padding="16"
            Margin="6"
            Height="116">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="آخرین همگام‌سازی"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="DashboardSyncText"
                       Text="در انتظار"
                       FontSize="17"
                       FontWeight="Bold"
                       Margin="0,5,0,2"/>
                        <TextBlock Text="وضعیت دریافت اطلاعات"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="22">
                    <StackPanel>
                        <TextBlock Text="دسترسی سریع" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="کارهای پرتکرار را مستقیم باز کن." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>
                        <Button Style="{StaticResource ActionButton}" Click="NewBooking_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#382126" CornerRadius="9" Padding="8" Margin="0,0,11,0">
                                    <TextBlock Text="＋" Foreground="#FFB1B5" FontSize="17"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="ثبت رزرو دستی" FontWeight="SemiBold"/>
                                    <TextBlock Text="انتخاب تاریخ، ساعت، دستگاه و بازی" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Click="Reservations_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#203346" CornerRadius="9" Padding="8" Margin="0,0,11,0">
                                    <TextBlock Text="▦" Foreground="#8CD8FF" FontSize="17"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="مدیریت رزروها" FontWeight="SemiBold"/>
                                    <TextBlock Text="مشاهده برنامه زمانی دستگاه‌ها" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1F3A30" CornerRadius="9" Padding="8" Margin="0,0,11,0">
                                    <TextBlock Text="↻" Foreground="#8FE4B8" FontSize="17"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="تازه‌سازی اطلاعات" FontWeight="SemiBold"/>
                                    <TextBlock Text="رفتن به نمای رزروها برای دریافت آخرین داده‌ها" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="22">
                    <StackPanel>
                        <TextBlock Text="نمای کلی" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="راهنمای وضعیت و شروع سریع" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>
                        <Border Background="#202D2A" BorderBrush="#31594B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="●  منبع اطلاعات" Foreground="#91E0B8" FontWeight="SemiBold"/>
                                <TextBlock Text="اطلاعات سرویس‌ها، دستگاه‌ها و رزروها از API سایت لابیکس دریافت می‌شود؛ آمار ساختگی در داشبورد نمایش داده نمی‌شود." Foreground="#C8D9D1" FontSize="12" Margin="0,6,0,0" LineHeight="21"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="نکتهٔ اپراتوری" FontWeight="SemiBold"/>
                                <TextBlock Text="قبل از تکرار ثبت رزرو پس از بروز خطا، ابتدا جدول رزروها را تازه‌سازی کن تا رزرو ثبت‌شدهٔ قبلی دوباره ارسال نشود." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" LineHeight="21"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2B1B22" BorderBrush="#543039" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="میانبر پیشنهادی" Foreground="#FFB1B5" FontWeight="SemiBold"/>
                                <TextBlock Text="برای مشاهدهٔ اشغال بودن هر دستگاه، وارد مدیریت رزروها شو و تاریخ موردنظر را انتخاب کن." Foreground="#D7C1C4" FontSize="12" Margin="0,6,0,0" LineHeight="21"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="8" Background="#151720" BorderBrush="#2D3040" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B1B22" CornerRadius="9" Padding="9" Margin="0,0,12,0">
                        <TextBlock Text="✦" FontSize="16" Foreground="#FFB1B5"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="طراحی‌شده برای کار سریع و دقیق" FontWeight="SemiBold"/>
                        <TextBlock Text="میانبرها، کنتراست بالا و بازخوردهای تعاملی برای کاهش کلیک‌های اضافه و خطاهای اپراتوری." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
