            for (let h = startHour; h < startHour + duration; h++) {
                const slot = (bookedSlots[dateIso] && bookedSlots[dateIso][h]) || {};
                const idBusy = sys.system_id && slot._physical_ids && slot._physical_ids[sys.id] && slot._physical_ids[sys.id][sys.system_id];
                const numberBusy = slot._physical && slot._physical[sys.id] && slot._physical[sys.id][sys.system_number];
                if (idBusy || numberBusy) {
                    invalid = { name: sys.name + ' / ' + sys.system_number, available: 0 };
                    return true;
                }
            }
            return false;
        });
    }

    if (bookingMode === 'manual') {

        invalid = {
            name: 'گیمنت',
            available: 0
        };
    }

    if (invalid) {

        $submitBtn
            .text('ادامه رزرو و پرداخت')
            .css('opacity', '1')
            .prop('disabled', false);

        if (invalid.available > 0) {

            showMessage(
                'ظرفیت «' +
                invalid.name +
                '» برای این بازه فقط ' +
