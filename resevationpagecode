if ( ! function_exists( 'lobix_product_ajax_availability' ) ) {

    function lobix_product_ajax_availability() {

        $product_id =
            isset(
                $_POST['product_id']
            )
                ? absint(
                    $_POST['product_id']
                )
                : 0;

        $nonce =
            isset(
                $_POST['nonce']
            )
                ? sanitize_text_field(
                    wp_unslash(
                        $_POST['nonce']
                    )
                )
                : '';

        if (
            ! $product_id ||
            ! wp_verify_nonce(
                $nonce,
                'lobix_product_availability_' .
                $product_id
            )
        ) {

            wp_send_json_error(
                [
                    'message' =>
                        'درخواست نامعتبر است.'
                ],
                403
            );
        }

        $product =
            wc_get_product(
                $product_id
            );

        if ( ! $product ) {

            wp_send_json_error(
                [
                    'message' =>
                        'گیمنت پیدا نشد.'
                ],
                404
            );
        }

        /*
         * تنظیمات لحظه‌ای.
         */

        $settings =
            lobix_product_get_settings(
                $product_id
            );

        /*
         * صفحه فعلی 8 روز را نشان می‌دهد.
         * کمی بیشتر می‌گیریم تا اگر ساعت نزدیک نیمه‌شب بود
         * مشکلی ایجاد نشود.
         */

        $booked =
            lobix_product_get_booked_slots(
                $product_id,
                '',
                14
            );

        lobix_reservation_apply_active_holds( $product_id, $booked );

        $variations =
            lobix_product_get_variations_data(
                $product_id
            );

        wp_send_json_success(
            [

                'settings' =>
                    $settings,

                'booked' =>
                    $booked,

                'variations' =>
                    $variations,

                'timestamp' =>
                    current_time(
                        'timestamp'
                    ),

            ]
        );
    }
}

add_action(
    'wp_ajax_lobix_product_availability',
    'lobix_product_ajax_availability'
);

add_action(
    'wp_ajax_nopriv_lobix_product_availability',
