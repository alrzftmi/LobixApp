function parseRowJson($row, attribute) {
    try {
        return JSON.parse($row.attr(attribute) || '[]');
    } catch (e) {
        return [];
    }
}



function buildDevicePickers() {

    $rows.each(function () {

        const $row = $(this);
        const $box = $row.find('.lx-device-options');

        $box.empty();

        const numbers = parseRowJson(
            $row,
            'data-system-numbers'
        );

        const games = parseRowJson(
            $row,
            'data-games'
        );
        const systemMap = parseRowJson( $row, 'data-system-map' );

        if (!numbers.length) {
            $box.append(
                $('<p></p>')
                    .text('شماره سیستمی برای این متغیر تعریف نشده است.')
                    .css('color', '#e74c3c')
            );
            return;
        }

        if (!games.length) {
            $box.append(
                $('<p></p>')
                    .text('بازی مجازی برای این متغیر تعریف نشده است.')
                    .css('color', '#e74c3c')
            );
            return;
        }

        numbers.forEach(function (number) {

            number = String(number);

            const systemMeta = systemMap[number] || {};
            const systemId = String(systemMeta.system_id || '');
            const $option = $('<div></div>')
                .addClass('lx-device-option')
                .attr('data-system-number', number)
                .attr('data-system-id', systemId);
            const systemActive = systemMeta.active !== false;
            const $checkbox = $('<input>')
                .attr('type', 'checkbox')
                .addClass('lx-device-check')
                .attr('data-system-number', number)
                .attr('data-system-id', systemId)
                .attr('data-system-active', systemActive ? '1' : '0')
                .prop('disabled', !systemActive)
                .val(number);

            const $title = $('<span></span>')
                .addClass('lx-device-number-label')
                .text('سیستم ' + number);

            const $gamePicker = $('<div></div>')
                .addClass('lx-device-game-picker')
                .hide();

            const $gameVisual = $('<div></div>')
                .addClass('lx-game-visual')
                .hide();

            const $gameImage = $('<img>')
                .addClass('lx-game-cover')
                .attr('alt', '')
                .attr('loading', 'lazy')
                .hide();

            const $gameName = $('<span></span>')
                .addClass('lx-game-visual-name')
                .text('هنوز بازی انتخاب نشده');

            $gameVisual.append(
                $gameImage,
                $gameName
            );

            const $gameSelect = $('<select></select>')
                .addClass('lx-device-game')
                .attr('aria-label', 'بازی سیستم ' + number)
                .prop('disabled', true)
                .prop('required', false);

            $gameSelect.append(
                $('<option></option>')
                    .val('')
                    .text('انتخاب بازی')
            );

            games.forEach(function (game) {

                if (
                    !game ||
                    !game.id ||
                    !game.name
                ) {
                    return;
                }

                const gameName = String(game.name);

                const gameImage = game.image
                    ? String(game.image)
                    : '';

                const $gameOption = $('<option></option>')
                    .val(String(game.id))
                    .text(gameName)
                    .attr('data-game-name', gameName)
                    .attr('data-game-image', gameImage);

                $gameSelect.append($gameOption);
            });

            $gameSelect.on('change', function () {

                const $selected = $(this).find('option:selected');

                const selectedId = String(
                    $(this).val() || ''
                );

                const selectedName = String(
                    $selected.attr('data-game-name') || ''
                );

                const selectedImage = String(
                    $selected.attr('data-game-image') || ''
                );

                if (!selectedId) {

                    $gameVisual.hide();

                    $gameImage
                        .removeAttr('src')
                        .hide();

                    $gameName.text('هنوز بازی انتخاب نشده');

                    return;
                }

                $gameName.text(selectedName);

                if (selectedImage) {

                    $gameImage
                        .attr('src', selectedImage)
                        .show();

                } else {

                    $gameImage
                        .removeAttr('src')
                        .hide();
                }

                $gameVisual.show();
            });

            $gameImage.on('error', function () {

                $(this)
                    .removeAttr('src')
                    .hide();
            });

            $gamePicker.append(
                $gameVisual,
                $gameSelect
            );

            $option.append(
                $checkbox,
                $title,
                $gamePicker
            );

            $box.append($option);
        });
    });
}
			
