            /* =================================================
             * FULLY BOOKED START HOURS
             *
             * اگر هیچ نوع سیستمی ظرفیت نداشته باشد،
             * ساعت شروع بسته می‌شود.
             * ================================================= */

            function updateTimeAvailability() {

                const dateIso =
                    getSelectedDate();

                if (!dateIso) {
                    return;
                }

                $('.lx-time-card').each(
                    function() {

                        const $card =
                            $(this);

                        const startHour =
                            parseInt(
                                $card.data(
                                    'hour'
                                ),
                                10
                            );

                        if (isPastStartTime(dateIso, startHour)) {
                            $card
                                .removeClass('active')
                                .addClass('disabled-slot past-slot')
                                .attr('title', 'این ساعت گذشته است و قابل انتخاب نیست');
                            return;
                        }

                        $card.removeClass('past-slot');

                        let hasCapacity =
                            false;

                        if (
                            stockStatus ===
                            'outofstock'
                        ) {

                            hasCapacity =
                                false;

                        } else {

                            $rows.each(
                                function() {

                                    const $row =
                                        $(this);

                                    const variationId =
                                        parseInt(
                                            $row.data(
                                                'variant-id'
                                            ),
                                            10
                                        );

                                    const capacity =
                                        parseInt(
                                            $row.data(
                                                'capacity'
                                            ),
                                            10
                                        ) || 1;

                                    const booked =
                                        getBooked(
                                            dateIso,
                                            startHour,
                                            variationId
                                        );

                                    if (
                                        capacity -
                                        booked >
                                        0
                                    ) {

                                        hasCapacity =
                                            true;

                                        return false;
                                    }
                                }
                            );
                        }

                        if (
                            hasCapacity
                        ) {

                            $card
                                .removeClass(
                                    'disabled-slot'
                                )
                                .removeAttr(
                                    'title'
                                );

                        } else {

                            $card
                                .addClass(
                                    'disabled-slot'
                                )
                                .attr(
                                    'title',
                                    'این ساعت ظرفیت ندارد'
                                );
                        }
                    }
                );
            }


