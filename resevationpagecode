function validateAvailability() {

    const dateIso = getSelectedDate();

    if (!dateIso) {
        return;
    }

    updateTimeAvailability();

    const selectedHour = getSelectedTimeHour();

    const duration = Math.max(
        1,
        parseInt($hoursInput.val(), 10) || 1
    );

    /*
     * هنوز ساعت شروع انتخاب نشده است.
     */
    if (selectedHour === null) {

        $rows.each(function () {

            const $row = $(this);

            $row
                .data('current-available', 0)
                .removeClass('disabled-sys');

            $row.find('.lx-stock-badge')
                .text('یک ساعت را انتخاب کنید')
                .css('color', '#94a3b8');

            // تا انتخاب ساعت، همه منوهای بازی غیرفعال باشند.
            $row.find('.lx-device-check').each(function () {
                $(this).prop('disabled', $(this).attr('data-system-active') === '0');
            });

            $row.find('.lx-device-option').each(function () {

                const $option = $(this);
                const $checkbox = $option.find('.lx-device-check');
                const $gameSelect = $option.find('.lx-device-game');
                const isSelected = $checkbox.is(':checked');

                $gameSelect
                    .prop('disabled', !isSelected)
                    .prop('required', isSelected);

                if (!isSelected) {
                    $gameSelect.val('');
                }
            });
        });

        updatePrice();
        return;
    }

    /*
     * اگر ساعت انتخاب‌شده دیگر ظرفیت نداشته باشد.
     */
    const $activeTime = $('.lx-time-card.active');

    if ($activeTime.hasClass('disabled-slot')) {

        $activeTime.removeClass('active');

        $rows.each(function () {

            const $row = $(this);

            $row
                .data('current-available', 0)
                .addClass('disabled-sys');

            $row.find('.lx-stock-badge')
                .text('این ساعت ظرفیت ندارد')
                .css('color', '#e74c3c');

            // انتخاب‌های قبلی پاک می‌شوند چون ظرفیت این ساعت صفر است.
            $row.find('.lx-device-check')
                .prop('checked', false)
                .prop('disabled', true);

            $row.find('.lx-device-option')
                .removeClass('selected');

            $row.find('.lx-device-game')
                .val('')
                .prop('disabled', true)
