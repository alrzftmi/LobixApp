if ( ! function_exists( 'lobix_product_ajax_booking_map' ) ) {
    function lobix_product_ajax_booking_map() {
        $product_id = isset( $_POST['product_id'] ) ? absint( $_POST['product_id'] ) : 0;
        $nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
        if ( ! $product_id || ! wp_verify_nonce( $nonce, 'lobix_product_availability_' . $product_id ) ) {
            wp_send_json_error( array( 'message' => 'درخواست نقشه معتبر نیست.' ), 403 );
        }
        $product = wc_get_product( $product_id );
        if ( ! $product || ! $product->is_type( 'variable' ) ) {
            wp_send_json_error( array( 'message' => 'گیمنت یا متغیرهای آن پیدا نشد.' ), 404 );
        }
        $date = isset( $_POST['date_iso'] ) ? sanitize_text_field( wp_unslash( $_POST['date_iso'] ) ) : '';
        $time = isset( $_POST['start_time'] ) ? sanitize_text_field( wp_unslash( $_POST['start_time'] ) ) : '';
        $hours = isset( $_POST['hours'] ) ? absint( $_POST['hours'] ) : 1;
        if ( ! preg_match( '/^\d{4}-\d{2}-\d{2}$/', $date ) || ! preg_match( '/^(?:[01]\d|2[0-3]):00$/', $time ) || $hours < 1 || $hours > 24 ) {
            wp_send_json_error( array( 'message' => 'تاریخ، ساعت یا مدت رزرو معتبر نیست.' ), 422 );
        }
        $start_hour = (int) substr( $time, 0, 2 );
        try {
            $requested_start = new DateTimeImmutable(
                $date . ' ' . sprintf( '%02d:00:00', $start_hour ),
                wp_timezone()
            );
            $server_now = new DateTimeImmutable( 'now', wp_timezone() );
        } catch ( Exception $e ) {
            wp_send_json_error( array( 'message' => 'تاریخ یا ساعت رزرو معتبر نیست.' ), 422 );
        }
        if ( $requested_start <= $server_now ) {
            wp_send_json_error( array( 'message' => 'ساعت شروع باید بعد از زمان فعلی باشد.' ), 422 );
        }
        $settings = lobix_product_get_settings( $product_id );
        if ( $start_hour < (int) $settings['work_start'] || ( $start_hour + $hours ) > (int) $settings['work_end'] ) {
            wp_send_json_error( array( 'message' => 'بازه انتخاب‌شده خارج از ساعات کاری است.' ), 422 );
        }
        $layout = lobix_reservation_get_floor_layout( $product_id );
        $devices = lobix_reservation_get_physical_registry( $product_id );
        $booked = lobix_product_get_booked_slots( $product_id, $date, 1 );
        $actual_booked = $booked;
        lobix_reservation_apply_active_holds( $product_id, $booked, $date );
        $now = new DateTimeImmutable( 'now', wp_timezone() );
        $now_date = $now->format( 'Y-m-d' );
        $now_hour = (int) $now->format( 'H' ) + ( (int) $now->format( 'i' ) / 60 );
        $out = array();
        foreach ( $devices as $device ) {
            $status = empty( $device['active'] ) ? 'off' : 'free';
            $conflict_hour = null;
            if ( $status !== 'off' ) {
                for ( $hour = $start_hour; $hour < $start_hour + $hours; $hour++ ) {
                    if ( lobix_reservation_device_is_booked( $booked, $date, $hour, $device ) ) {
                        $conflict_hour = $hour;
                        break;
                    }
                }
                if ( $conflict_hour !== null ) {
                    $currently_in_use = ( $date === $now_date ) && lobix_reservation_device_currently_in_use( $actual_booked, $date, $now_hour, $start_hour, $hours, $device );
                    $status = $currently_in_use ? 'in_use' : 'reserved';
                }
            }
            $device['status'] = $status;
            $out[] = $device;
        }
        wp_send_json_success( array(
            'product_id' => $product_id,
            'date' => $date,
            'start_time' => $time,
            'hours' => $hours,
            'layout' => $layout,
            'devices' => $out,
            'server_time' => current_time( 'c' ),
            'has_registry' => ! empty( $devices ),
        ) );
    }
}
