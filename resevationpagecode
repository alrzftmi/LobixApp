function closeBookingMap() {
    if (!$bookingMap.hasClass('is-visible')) return;

    /*
     * فقط دستگاه‌های انتخاب‌شده باید بعد از بسته‌شدن نقشه در فهرست بازی‌ها بمانند.
     * اگر کاربر بدون انتخاب دستگاه نقشه را ببندد، فهرست آن نوع سیستم جمع می‌شود.
     */
    const $activeRow = activeMapVariantId
        ? $rows.filter('[data-variant-id="' + String(activeMapVariantId) + '"]').first()
        : $();

    if ($activeRow.length) {
        const $options = $activeRow.find('.lx-device-option');
        const selectedCount = $options.find('.lx-device-check:checked').length;

        $options.each(function () {
            const $option = $(this);
            const selected = $option.find('.lx-device-check').is(':checked');
            $option.toggleClass('lx-device-hidden', !selected);
            $option.find('.lx-device-game-picker').toggle(selected);
        });

        if (selectedCount > 0) {
            $activeRow.addClass('active lx-expanded');
            $activeRow.find('.lx-device-picker').show();
        } else {
            $activeRow.removeClass('active lx-expanded');
            $activeRow.find('.lx-device-picker').hide();
            $options.addClass('lx-device-hidden');
        }
    }

    if (bookingMapRequest && bookingMapRequest.readyState !== 4) bookingMapRequest.abort();
    bookingMapRequestSeq++;
    $bookingMap.removeClass('is-visible').attr('aria-hidden', 'true');
    document.body.classList.remove('lx-map-modal-open');
}

function activateSystemType($row) {
    if (!$row || !$row.length) return;
    const nextId = parseInt($row.attr('data-variant-id'), 10) || 0;
    if (!nextId) return;

    const dateIso = getSelectedDate();
    const selectedHour = getSelectedTimeHour();
    if (!dateIso || selectedHour === null) {
        showMessage('ابتدا روز و ساعت شروع رزرو را انتخاب کنید.');
        return;
    }

    activeMapVariantId = nextId;
    $row.find('.lx-device-option').removeClass('lx-device-hidden').each(function () {
        const $option = $(this);
        $option.find('.lx-device-game-picker').toggle($option.find('.lx-device-check').is(':checked'));
    });
    $rows.removeClass('active lx-expanded').each(function () {
        const $item = $(this);
        const isActive = parseInt($item.attr('data-variant-id'), 10) === nextId;
        $item.toggleClass('active lx-expanded', isActive);
        $item.find('.lx-device-picker').toggle(isActive);
    });

    $bookingMap.find('[data-role="booking-map-title"]').text('نقشه و انتخاب دستگاه‌ها · ' + String($row.attr('data-name') || $row.find('.lx-name').text()).trim());
    $bookingMap.addClass('is-visible').attr('aria-hidden', 'false');
    document.body.classList.add('lx-map-modal-open');
    updateMapSelectedSummary();
    $bookingMapMessage.text('در حال بارگذاری نقشه کامل گیمنت و وضعیت دستگاه‌ها…');
    refreshBookingMap();

    const closeButton = $bookingMap.find('[data-action="close-map"]').get(0);
    if (closeButton) window.setTimeout(() => closeButton.focus(), 50);
}

