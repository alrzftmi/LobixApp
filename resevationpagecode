if ( ! function_exists( 'lobix_reservation_system_number_key' ) ) {
    function lobix_reservation_system_number_key( $value ) {
        $value = trim( (string) $value );
        $value = strtr( $value, array(
            '۰'=>'0','۱'=>'1','۲'=>'2','۳'=>'3','۴'=>'4','۵'=>'5','۶'=>'6','۷'=>'7','۸'=>'8','۹'=>'9',
            '٠'=>'0','١'=>'1','٢'=>'2','٣'=>'3','٤'=>'4','٥'=>'5','٦'=>'6','٧'=>'7','٨'=>'8','٩'=>'9',
        ) );
        if ( preg_match( '/(\d+)\s*$/u', $value, $m ) ) {
            return (string) absint( $m[1] );
        }
        return function_exists( 'mb_strtolower' ) ? mb_strtolower( $value, 'UTF-8' ) : strtolower( $value );
    }
}

if ( ! function_exists( 'lobix_reservation_get_physical_registry' ) ) {
    function lobix_reservation_get_physical_registry( $product_id ) {
        $raw = get_post_meta( absint( $product_id ), '_lobix_physical_systems_v1', true );
        if ( ! is_array( $raw ) ) return array();
        $out = array();
        foreach ( $raw as $row ) {
            if ( ! is_array( $row ) ) continue;
            $id = isset( $row['system_id'] ) ? sanitize_text_field( (string) $row['system_id'] ) : '';
            $number = isset( $row['number'] ) ? absint( $row['number'] ) : 0;
            $variation_id = isset( $row['variation_id'] ) ? absint( $row['variation_id'] ) : 0;
            $category = isset( $row['category'] ) ? sanitize_text_field( (string) $row['category'] ) : '';
            if ( $id === '' || $number < 1 || $category === '' ) continue;
            $out[] = array(
                'system_id' => $id,
                'number' => $number,
                'label' => $category . '-' . $number,
                'category' => $category,
                'variation_id' => $variation_id,
                'active' => ! array_key_exists( 'active', $row ) || (bool) $row['active'],
            );
        }
        return $out;
    }
}

if ( ! function_exists( 'lobix_reservation_get_floor_layout' ) ) {
    function lobix_reservation_get_floor_layout( $product_id ) {
        $layout = get_post_meta( absint( $product_id ), '_lobix_floor_layout_v1', true );
        if ( ! is_array( $layout ) ) $layout = array();
        return array(
            'version' => isset( $layout['version'] ) ? absint( $layout['version'] ) : 1,
            'width' => isset( $layout['width'] ) ? max( 200, absint( $layout['width'] ) ) : 1000,
            'height' => isset( $layout['height'] ) ? max( 200, absint( $layout['height'] ) ) : 700,
            'objects' => isset( $layout['objects'] ) && is_array( $layout['objects'] ) ? array_values( $layout['objects'] ) : array(),
        );
    }
}


if ( ! function_exists( 'lobix_reservation_device_currently_in_use' ) ) {
    function lobix_reservation_device_currently_in_use( $booked, $date_iso, $now_hour, $selected_start, $selected_hours, $device ) {
        $variation_id = absint( $device['variation_id'] ?? 0 );
        $day = isset( $booked[ $date_iso ] ) && is_array( $booked[ $date_iso ] ) ? $booked[ $date_iso ] : array();
        $ranges = array();
        $physical = $day['_physical_ranges'][ $variation_id ] ?? array();
        $system_id = (string) ( $device['system_id'] ?? '' );
        if ( $system_id !== '' && ! empty( $physical['id'][ $system_id ] ) ) {
            $ranges = array_merge( $ranges, $physical['id'][ $system_id ] );
        }
        $target = lobix_reservation_system_number_key( $device['label'] ?? $device['number'] ?? '' );
        foreach ( (array) ( $physical['number'] ?? array() ) as $number => $items ) {
            if ( lobix_reservation_system_number_key( $number ) === $target ) {
                $ranges = array_merge( $ranges, (array) $items );
            }
        }
        $ranges = array_merge( $ranges, (array) ( $day['_legacy_ranges'][ $variation_id ] ?? array() ) );
        $selected_end = (int) $selected_start + (int) $selected_hours;
        foreach ( $ranges as $range ) {
            if ( ! is_array( $range ) ) continue;
            $start = absint( $range['start'] ?? 0 );
            $end = $start + max( 1, absint( $range['hours'] ?? 1 ) );
            $overlaps_selected = $start < $selected_end && (int) $selected_start < $end;
            $active_now = $start <= (float) $now_hour && $end > (float) $now_hour;
            if ( $overlaps_selected && $active_now ) return true;
        }
        return false;
    }
}

if ( ! function_exists( 'lobix_reservation_device_is_booked' ) ) {
    function lobix_reservation_device_is_booked( $booked, $date_iso, $hour, $device ) {
        $slot = isset( $booked[ $date_iso ][ $hour ] ) && is_array( $booked[ $date_iso ][ $hour ] )
            ? $booked[ $date_iso ][ $hour ] : array();
        $variation_id = absint( $device['variation_id'] ?? 0 );
        $system_id = (string) ( $device['system_id'] ?? '' );
        if ( $system_id !== '' && ! empty( $slot['_physical_ids'][ $variation_id ][ $system_id ] ) ) return true;
        foreach ( (array) ( $booked[ $date_iso ]['_legacy_ranges'][ $variation_id ] ?? array() ) as $legacy_range ) {
            $legacy_start = absint( $legacy_range['start'] ?? 0 );
            $legacy_end = $legacy_start + max( 1, absint( $legacy_range['hours'] ?? 1 ) );
            if ( (int) $hour >= $legacy_start && (int) $hour < $legacy_end ) return true;
        }
        $numbers = isset( $slot['_physical'][ $variation_id ] ) && is_array( $slot['_physical'][ $variation_id ] )
            ? $slot['_physical'][ $variation_id ] : array();
        $target_keys = array( (string) ( $device['label'] ?? '' ), (string) ( $device['number'] ?? '' ) );
        foreach ( $numbers as $booked_number => $yes ) {
            if ( ! $yes ) continue;
            foreach ( $target_keys as $target ) {
                if ( $target !== '' && lobix_reservation_system_number_key( $booked_number ) === lobix_reservation_system_number_key( $target ) ) return true;
            }
        }
        return false;
    }
}


/* ============================================================
 * 11.2 SHORT-LIVED CHECKOUT HOLDS
 *
 * Page-level WooCommerce holds only. No API route or API schema changes.
 * Holds expire automatically if a visitor abandons the cart.
 * ============================================================ */

if ( ! function_exists( 'lobix_reservation_get_session_key' ) ) {
    function lobix_reservation_get_session_key() {
        if ( ! function_exists( 'WC' ) || ! WC() || ! WC()->session ) return '';
        $key = WC()->session->get( 'lobix_reservation_session_key' );
        if ( ! is_string( $key ) || $key === '' ) {
            $key = wp_generate_uuid4();
            WC()->session->set( 'lobix_reservation_session_key', $key );
        }
        return hash( 'sha256', $key );
    }
}

if ( ! function_exists( 'lobix_reservation_hold_option_key' ) ) {
    function lobix_reservation_hold_option_key( $product_id, $date, $hour, $variation_id, $system_id, $system_number ) {
        $identity = $system_id !== '' ? 'id:' . $system_id : 'number:' . $variation_id . ':' . lobix_reservation_system_number_key( $system_number );
        return 'lobix_res_hold_' . absint( $product_id ) . '_' . preg_replace( '/[^0-9]/', '', (string) $date ) . '_' . absint( $hour ) . '_' . absint( $variation_id ) . '_' . substr( hash( 'sha256', $identity ), 0, 32 );
    }
}

if ( ! function_exists( 'lobix_reservation_get_active_holds' ) ) {
    function lobix_reservation_get_active_holds( $product_id, $date = '' ) {
        global $wpdb;
        $prefix = 'lobix_res_hold_' . absint( $product_id ) . '_';
        $rows = $wpdb->get_results( $wpdb->prepare(
            "SELECT option_name, option_value FROM {$wpdb->options} WHERE option_name LIKE %s",
            $wpdb->esc_like( $prefix ) . '%'
        ), ARRAY_A );
        $active = array();
        $now = time();
        foreach ( (array) $rows as $row ) {
            $hold = maybe_unserialize( $row['option_value'] );
            if ( ! is_array( $hold ) || empty( $hold['expires_at'] ) || (int) $hold['expires_at'] <= $now ) {
                delete_option( $row['option_name'] );
                continue;
            }
            if ( $date !== '' && (string) ( $hold['date'] ?? '' ) !== (string) $date ) continue;
            $hold['_option_name'] = $row['option_name'];
            $active[] = $hold;
        }
        return $active;
    }
}

if ( ! function_exists( 'lobix_reservation_apply_active_holds' ) ) {
    function lobix_reservation_apply_active_holds( $product_id, &$booked, $date = '', $exclude_session = '' ) {
        $holds = lobix_reservation_get_active_holds( $product_id, $date );
        foreach ( $holds as $hold ) {
            if ( $exclude_session !== '' && hash_equals( (string) ( $hold['session_id'] ?? '' ), (string) $exclude_session ) ) continue;
            $day = (string) ( $hold['date'] ?? '' );
            $hour = absint( $hold['hour'] ?? 0 );
            $variation_id = absint( $hold['variation_id'] ?? 0 );
            if ( $day === '' || $variation_id < 1 || $hour > 23 ) continue;
            if ( ! isset( $booked[ $day ][ $hour ] ) ) $booked[ $day ][ $hour ] = array();
            if ( ! isset( $booked[ $day ][ $hour ][ $variation_id ] ) ) $booked[ $day ][ $hour ][ $variation_id ] = 0;
            $booked[ $day ][ $hour ][ $variation_id ]++;
            $system_id = (string) ( $hold['system_id'] ?? '' );
            $system_number = (string) ( $hold['system_number'] ?? '' );
            if ( $system_id !== '' ) {
                if ( ! isset( $booked[ $day ][ $hour ]['_physical_ids'][ $variation_id ] ) ) $booked[ $day ][ $hour ]['_physical_ids'][ $variation_id ] = array();
                $booked[ $day ][ $hour ]['_physical_ids'][ $variation_id ][ $system_id ] = true;
            }
            if ( $system_number !== '' ) {
                if ( ! isset( $booked[ $day ][ $hour ]['_physical'][ $variation_id ] ) ) $booked[ $day ][ $hour ]['_physical'][ $variation_id ] = array();
                $booked[ $day ][ $hour ]['_physical'][ $variation_id ][ $system_number ] = true;
            }
        }
        return $booked;
    }
}

if ( ! function_exists( 'lobix_reservation_claim_holds' ) ) {
    function lobix_reservation_claim_holds( $product_id, $date, $start_hour, $hours, $systems, $session_id ) {
        $claimed = array();
        $by_system = array();
        $expires = time() + ( 30 * MINUTE_IN_SECONDS );
        foreach ( $systems as $index => $system ) {
            $by_system[ $index ] = array();
            for ( $hour = (int) $start_hour; $hour < ( (int) $start_hour + (int) $hours ); $hour++ ) {
                $system_id = (string) ( $system['system_id'] ?? '' );
                $system_number = (string) ( $system['system_number'] ?? '' );
                $variation_id = absint( $system['variation_id'] ?? 0 );
                $key = lobix_reservation_hold_option_key( $product_id, $date, $hour, $variation_id, $system_id, $system_number );
                $existing = get_option( $key, false );
                if ( is_array( $existing ) && (int) ( $existing['expires_at'] ?? 0 ) <= time() ) {
                    delete_option( $key );
                    $existing = false;
                }
                if ( is_array( $existing ) && (int) ( $existing['expires_at'] ?? 0 ) > time() && (string) ( $existing['session_id'] ?? '' ) !== (string) $session_id ) {
                    lobix_reservation_release_hold_keys( $claimed, $session_id );
                    return new WP_Error( 'device_temporarily_held', 'این دستگاه در سبد رزرو مشتری دیگری قرار دارد. لطفاً دستگاه دیگری انتخاب کنید.' );
                }
                $record = array(
                    'product_id' => absint( $product_id ), 'date' => (string) $date,
                    'hour' => (int) $hour, 'variation_id' => $variation_id,
                    'system_id' => $system_id, 'system_number' => $system_number,
                    'session_id' => (string) $session_id, 'order_id' => 0,
                    'expires_at' => $expires,
                );
                if ( is_array( $existing ) && (string) ( $existing['session_id'] ?? '' ) === (string) $session_id ) {
                    update_option( $key, $record, false );
                } else {
                    if ( ! add_option( $key, $record, '', false ) ) {
                        $race = get_option( $key, false );
                        if ( ! is_array( $race ) || (int) ( $race['expires_at'] ?? 0 ) <= time() || (string) ( $race['session_id'] ?? '' ) !== (string) $session_id ) {
                            lobix_reservation_release_hold_keys( $claimed, $session_id );
                            return new WP_Error( 'device_temporarily_held', 'این دستگاه هم‌زمان توسط مشتری دیگری انتخاب شد. لطفاً دوباره وضعیت را بررسی کنید.' );
                        }
                        update_option( $key, $record, false );
                    }
                }
                $claimed[] = $key;
                $by_system[ $index ][] = $key;
            }
        }
        return array( 'keys' => $claimed, 'by_system' => $by_system );
    }
}

if ( ! function_exists( 'lobix_reservation_release_hold_keys' ) ) {
    function lobix_reservation_release_hold_keys( $keys, $session_id = '' ) {
        foreach ( (array) $keys as $key ) {
            if ( ! is_string( $key ) || strpos( $key, 'lobix_res_hold_' ) !== 0 ) continue;
            $hold = get_option( $key, false );
            if ( ! is_array( $hold ) ) continue;
            if ( $session_id !== '' && (string) ( $hold['session_id'] ?? '' ) !== (string) $session_id ) continue;
            if ( ! empty( $hold['order_id'] ) ) continue;
            delete_option( $key );
        }
    }
}

if ( ! function_exists( 'lobix_reservation_attach_order_holds' ) ) {
    function lobix_reservation_attach_order_holds( $order_id ) {
        $order = wc_get_order( $order_id );
        if ( ! $order ) return;
        if ( in_array( $order->get_status(), array( 'on-hold', 'processing', 'completed', 'cancelled', 'failed', 'refunded' ), true ) ) {
            lobix_reservation_release_order_holds( $order_id );
            return;
        }
        foreach ( $order->get_items( 'line_item' ) as $item ) {
            $keys = $item->get_meta( '_lx_reservation_hold_keys', true );
            foreach ( (array) $keys as $key ) {
                if ( ! is_string( $key ) || strpos( $key, 'lobix_res_hold_' ) !== 0 ) continue;
                $hold = get_option( $key, false );
                if ( ! is_array( $hold ) ) continue;
                $hold['order_id'] = absint( $order_id );
                $hold['expires_at'] = time() + ( 45 * MINUTE_IN_SECONDS );
                update_option( $key, $hold, false );
            }
        }
    }
}

if ( ! function_exists( 'lobix_reservation_release_order_holds' ) ) {
    function lobix_reservation_release_order_holds( $order_id ) {
        $order = wc_get_order( $order_id );
        if ( ! $order ) return;
        foreach ( $order->get_items( 'line_item' ) as $item ) {
            $keys = $item->get_meta( '_lx_reservation_hold_keys', true );
            foreach ( (array) $keys as $key ) {
                if ( is_string( $key ) && strpos( $key, 'lobix_res_hold_' ) === 0 ) delete_option( $key );
            }
        }
    }
}

