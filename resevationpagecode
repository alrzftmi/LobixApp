/* ============================================================
 * 1. CATEGORY PATH
 * ============================================================ */

if ( ! function_exists( 'lobix_product_get_category_full_path' ) ) {

    function lobix_product_get_category_full_path( $product_id ) {

        $terms = get_the_terms( $product_id, 'product_cat' );

        if ( ! $terms || is_wp_error( $terms ) ) {
            return '';
        }

        $deepest   = null;
        $max_depth = -1;

        foreach ( $terms as $term ) {

            $depth     = 0;
            $parent_id = (int) $term->parent;

            while ( $parent_id ) {

                $parent = get_term(
                    $parent_id,
                    'product_cat'
                );

                if ( ! $parent || is_wp_error( $parent ) ) {
                    break;
                }

                $depth++;
                $parent_id = (int) $parent->parent;
            }

            if ( $depth > $max_depth ) {
                $max_depth = $depth;
                $deepest   = $term;
            }
        }

        if ( ! $deepest ) {
            return '';
        }

        $path    = [];
        $current = $deepest;

        while ( $current ) {

            array_unshift(
                $path,
                $current->name
            );

            if ( ! $current->parent ) {
                break;
            }

            $current = get_term(
                $current->parent,
                'product_cat'
            );

            if ( ! $current || is_wp_error( $current ) ) {
                break;
            }
        }

        return implode(
            ' / ',
            $path
        );
    }
}


/* ============================================================
 * 2. CAPACITY
 * ============================================================ */

if ( ! function_exists( 'lobix_product_get_capacity' ) ) {

    function lobix_product_get_capacity(
        $variation_id,
        $product_id = 0
    ) {

        $target_id = $variation_id
            ? absint( $variation_id )
            : absint( $product_id );

        $capacity = get_post_meta(
            $target_id,
            '_gamenet_var_capacity',
            true
        );

        if ( $capacity === '' ) {
            return 1;
        }

        return max(
            1,
            absint( $capacity )
        );
    }
}


/* ============================================================
 * 3. SETTINGS
 * ============================================================ */

if ( ! function_exists( 'lobix_product_get_settings' ) ) {

    function lobix_product_get_settings( $product_id ) {

        $start = get_post_meta(
            $product_id,
            '_gamenet_work_start',
            true
        );

        $end = get_post_meta(
            $product_id,
            '_gamenet_work_end',
            true
        );

        $mode = get_post_meta(
            $product_id,
            '_gamenet_booking_mode',
            true
        );

        $stock = get_post_meta(
            $product_id,
            '_stock_status',
            true
        );

        $start = (
            $start !== ''
        )
            ? max( 0, min( 23, absint( $start ) ) )
            : 8;

        $end = (
            $end !== ''
        )
            ? max( 1, min( 24, absint( $end ) ) )
            : 24;

        if ( $end <= $start ) {
            $end = min(
                24,
                $start + 1
            );
        }

        return [

            'work_start'   => $start,

            'work_end'     => $end,

            'booking_mode' => $mode ?: 'auto',

            'stock_status' => $stock ?: 'instock',

        ];
    }
}


/* ============================================================
 * 4. PRODUCT PRIMARY ID
 *
 * داشبورد از اولین محصول مالک به عنوان Primary استفاده می‌کند.
 * ============================================================ */

if ( ! function_exists( 'lobix_product_get_primary_id' ) ) {

    function lobix_product_get_primary_id( $product_id ) {

        $product_id = absint( $product_id );

        if ( ! $product_id ) {
            return 0;
        }

        /*
         * اول خود محصول.
         */

        $direct = get_option(
            'lobix_manual_bookings_' . $product_id,
            null
        );

        if ( is_array( $direct ) ) {
            return $product_id;
        }

        /*
         * اگر محصول Variable است،
         * ممکن است رزروها روی محصول اصلی دیگری ذخیره شده باشند.
         */

        $product = wc_get_product( $product_id );

        if ( ! $product ) {
            return $product_id;
        }

        $variation_ids = [];

        if ( $product->is_type( 'variable' ) ) {

            $variation_ids = array_map(
                'absint',
                $product->get_children()
            );
        }

        if ( empty( $variation_ids ) ) {
            return $product_id;
        }

        global $wpdb;

        $like = $wpdb->esc_like(
            'lobix_manual_bookings_'
        ) . '%';

        $rows = $wpdb->get_results(
            $wpdb->prepare(
                "SELECT option_name, option_value
                 FROM {$wpdb->options}
                 WHERE option_name LIKE %s",
                $like
            ),
            ARRAY_A
        );

        if ( empty( $rows ) ) {
            return $product_id;
        }

        foreach ( $rows as $row ) {

            $value = maybe_unserialize(
                $row['option_value']
            );

            if ( ! is_array( $value ) ) {
                continue;
            }

            foreach ( $value as $booking ) {

                if ( ! is_array( $booking ) ) {
                    continue;
                }

                $var_id = isset( $booking['var_id'] )
                    ? absint( $booking['var_id'] )
                    : 0;

                if (
                    $var_id &&
                    in_array(
                        $var_id,
                        $variation_ids,
                        true
                    )
                ) {

                    $prefix = 'lobix_manual_bookings_';

                    if (
                        strpos(
                            $row['option_name'],
                            $prefix
                        ) === 0
                    ) {

                        return absint(
                            substr(
                                $row['option_name'],
                                strlen( $prefix )
                            )
                        );
                    }
                }
            }
        }

        return $product_id;
    }
}


/* ============================================================
 * 5. MANUAL BOOKINGS
 * ============================================================ */

if ( ! function_exists( 'lobix_product_get_manual_bookings' ) ) {

    function lobix_product_get_manual_bookings(
        $product_id
    ) {

        $product_id = absint( $product_id );

        if ( ! $product_id ) {
            return [];
        }

        /*
         * اول Primary واقعی را پیدا می‌کنیم.
         */

        $primary_id = lobix_product_get_primary_id(
            $product_id
        );

        $bookings = get_option(
            'lobix_manual_bookings_' . $primary_id,
            []
        );

        if ( ! is_array( $bookings ) ) {
            return [];
        }

        return array_values(
            $bookings
        );
    }
}


/* ============================================================
 * 6. DAY NORMALIZER
 * ============================================================ */

if ( ! function_exists( 'lobix_product_normalize_day_code' ) ) {

    function lobix_product_normalize_day_code(
        $day
    ) {

        $day = trim(
            wp_strip_all_tags(
                (string) $day
            )
        );

        if ( $day === '' ) {
            return '';
        }

        $map = [

            'sat'       => 'Sat',
            'saturday'  => 'Sat',
            'شنبه'      => 'Sat',

            'sun'       => 'Sun',
            'sunday'    => 'Sun',
            'یکشنبه'    => 'Sun',
            'يکشنبه'    => 'Sun',

            'mon'       => 'Mon',
            'monday'    => 'Mon',
            'دوشنبه'    => 'Mon',

            'tue'       => 'Tue',
            'tuesday'   => 'Tue',
            'سه شنبه'   => 'Tue',
            'سه‌شنبه'   => 'Tue',

            'wed'       => 'Wed',
            'wednesday' => 'Wed',
            'چهارشنبه'  => 'Wed',

            'thu'       => 'Thu',
            'thursday'  => 'Thu',
            'پنجشنبه'   => 'Thu',
            'پنج‌شنبه'  => 'Thu',

            'fri'       => 'Fri',
            'friday'    => 'Fri',
            'جمعه'      => 'Fri',

        ];

        $key = strtolower( $day );

        return $map[ $key ] ?? $day;
    }
}


/* ============================================================
 * 7. MANUAL BOOKING MATCH
 * ============================================================ */

if ( ! function_exists( 'lobix_product_manual_booking_matches_slot' ) ) {

    function lobix_product_manual_booking_matches_slot(
        $booking,
        $date_iso,
        $hour
    ) {

        if ( ! is_array( $booking ) ) {
            return false;
        }

        $hour = absint( $hour );

        /*
         * ساعت.
         */

        $stored_hour = null;

        foreach (
            [
                'hour',
                'start_hour',
                'booking_hour'
            ] as $key
        ) {

            if (
                isset( $booking[ $key ] ) &&
                $booking[ $key ] !== ''
            ) {

                $value = (string) $booking[ $key ];

                if (
                    preg_match(
                        '/(?:^|\D)(\d{1,2})(?::\d{2})?/',
                        $value,
                        $matches
                    )
                ) {

                    $stored_hour =
                        absint(
                            $matches[1]
                        );

                } else {

                    $stored_hour =
                        absint( $value );
                }

                break;
            }
        }

        if (
            $stored_hour === null ||
            $stored_hour !== $hour
        ) {
            return false;
        }

        /*
         * اگر تاریخ دقیق ذخیره شده باشد.
         */

        foreach (
            [
                'date_iso',
                'booking_date',
                'date',
                'full_date'
            ] as $key
        ) {

            if (
                ! empty(
                    $booking[ $key ]
                )
            ) {

                $stored_date =
                    sanitize_text_field(
                        (string) $booking[ $key ]
                    );

                if (
                    preg_match(
                        '/^\d{4}-\d{2}-\d{2}$/',
                        $stored_date
                    )
                ) {

                    return (
                        $stored_date ===
                        $date_iso
                    );
                }
            }
        }

        /*
         * داشبورد فعلی بر اساس day_code کار می‌کند.
         */

        $stored_day = '';

        foreach (
            [
                'day_code',
                'weekday',
                'week_day',
                'day'
            ] as $key
        ) {

            if (
                isset( $booking[ $key ] ) &&
                $booking[ $key ] !== ''
            ) {

                $stored_day =
                    lobix_product_normalize_day_code(
                        $booking[ $key ]
                    );

                break;
            }
        }

        if ( $stored_day === '' ) {
            return false;
        }

        try {

            $date = new DateTimeImmutable(
                $date_iso . ' 12:00:00',
                wp_timezone()
            );

            $date_day =
                $date->format( 'D' );

        } catch ( Exception $e ) {

            return false;
        }

        return (
            lobix_product_normalize_day_code(
                $date_day
            ) === $stored_day
        );
    }
}


/* ============================================================
 * 8. ORDER BOOKING PARSER
 * ============================================================ */

if ( ! function_exists( 'lobix_product_parse_order_item_booking' ) ) {

    function lobix_product_parse_order_item_booking(
        $item
    ) {

        $result = [

            'date_iso' => sanitize_text_field(
                (string) $item->get_meta(
                    '_lx_date_iso',
                    true
                )
            ),

            'start' => null,

            'hours' => 0,

        ];

        /*
         * Meta استاندارد.
         */

        $start = $item->get_meta(
            '_lx_start_time',
            true
        );

        $hours = $item->get_meta(
            '_lx_hours',
            true
        );

        if (
            $start !== '' &&
            preg_match(
                '/^\s*(\d{1,2})(?::\d{2})?/',
                (string) $start,
                $matches
            )
        ) {

            $hour = absint(
                $matches[1]
            );

            if (
                $hour >= 0 &&
                $hour <= 23
            ) {

                $result['start'] = $hour;
            }
        }

        if (
            $hours !== '' &&
            is_numeric( $hours )
        ) {

            $result['hours'] =
                max(
                    0,
                    min(
                        24,
                        absint( $hours )
                    )
                );
        }

        /*
         * Compatibility با سفارش‌های قدیمی.
         */

        foreach (
            $item->get_meta_data()
            as $meta
        ) {

            $key = (string) $meta->key;

            $value = (string) $meta->value;

            if (
                in_array(
                    $key,
                    [
                        '_lx_date_iso',
                        '_lx_start_time',
                        '_lx_hours'
                    ],
                    true
                )
            ) {
                continue;
            }

            $clean_key =
                wp_strip_all_tags(
                    html_entity_decode(
                        $key
                    )
                );

            $clean_value =
                wp_strip_all_tags(
                    html_entity_decode(
                        $value
                    )
                );

            /*
             * Start.
             */

            if (
                $result['start'] === null
            ) {

                if (
                    preg_match(
                        '/زمان|شروع|start|time/i',
                        $clean_key
                    )
                ) {

                    if (
                        preg_match(
                            '/(?:^|\D)(\d{1,2})(?::|[.]|\s)(\d{2})?/',
                            $clean_value,
                            $matches
                        )
                    ) {

                        $hour =
                            absint(
                                $matches[1]
                            );

                        if (
                            $hour >= 0 &&
                            $hour <= 23
                        ) {

                            $result['start'] =
                                $hour;
                        }
                    }
                }
            }

            /*
             * Duration.
             */

            if (
                $result['hours'] <= 0 &&
                preg_match(
                    '/مدت|duration|hours|hour/i',
                    $clean_key
                )
            ) {

                if (
                    preg_match(
                        '/(?:^|\D)(\d{1,2})(?:\D|$)/u',
                        $clean_value,
                        $matches
                    )
                ) {

                    $duration =
                        absint(
                            $matches[1]
                        );

                    if (
                        $duration >= 1 &&
                        $duration <= 24
                    ) {

                        $result['hours'] =
                            $duration;
                    }
                }
            }
        }

        return $result;
    }
}


/* LOBIX RESERVATION: PHYSICAL SYSTEMS AND GAMES */

if ( ! function_exists( 'lobix_reservation_array_value' ) ) {
    function lobix_reservation_array_value( $value ) {
        if ( is_array( $value ) ) {
            return array_values( $value );
        }

        if ( ! is_string( $value ) || trim( $value ) === '' ) {
            return array();
        }

        $decoded = json_decode( $value, true );

        if ( is_array( $decoded ) ) {
            return array_values( $decoded );
        }

        return array_values(
            array_filter(
                array_map( 'trim', explode( ',', $value ) ),
                'strlen'
            )
        );
    }
}

if ( ! function_exists( 'lobix_reservation_get_system_numbers' ) ) {
    function lobix_reservation_get_system_numbers( $variation_id ) {
        $numbers = lobix_reservation_array_value(
            get_post_meta(
                $variation_id,
                '_lobix_system_numbers_v2',
                true
            )
        );

        $numbers = array_values(
            array_unique(
                array_filter(
                    array_map(
                        'strval',
                        $numbers
                    ),
                    'strlen'
                )
            )
        );

        if ( ! empty( $numbers ) ) {
            return $numbers;
        }

        $count = absint(
            get_post_meta(
                $variation_id,
                '_lobix_system_count_v2',
                true
            )
        );

        if ( $count < 1 ) {
            return array();
        }

        return range( 1, $count );
    }
}

if ( ! function_exists( 'lobix_reservation_get_allowed_games' ) ) {
    function lobix_reservation_get_allowed_games(
        $product_id,
        $variation_id
    ) {
        $product_games = lobix_reservation_array_value(
            get_post_meta(
                $product_id,
                '_lobix_product_games_v2',
                true
            )
        );

        $variation_games = lobix_reservation_array_value(
            get_post_meta(
                $variation_id,
                '_lobix_variation_games_v2',
                true
            )
        );

        $product_games = array_map( 'absint', $product_games );
        $variation_games = array_map( 'absint', $variation_games );

        $allowed_ids = array_values(
            array_unique(
                array_intersect(
                    $product_games,
                    $variation_games
                )
            )
        );

        $games = array();

        foreach ( $allowed_ids as $game_id ) {
            if ( get_post_type( $game_id ) !== 'lobix_game' ) {
                continue;
            }

            if ( get_post_status( $game_id ) !== 'publish' ) {
                continue;
            }

            $games[] = array(
                'id'    => $game_id,
                'title' => get_the_title( $game_id ),
            );
        }

        return $games;
    }
}

/* ============================================================
 * 9. GET VARIATIONS
 * ============================================================ */


if ( ! function_exists( 'lobix_product_get_variations_data' ) ) {

    function lobix_product_get_variations_data( $product_id ) {

        $product = wc_get_product( $product_id );
        $result = [];

        if ( ! $product ) {
            return $result;
        }

        if ( $product->is_type( 'variable' ) ) {

            foreach ( $product->get_children() as $variation_id ) {

                $variation = wc_get_product( $variation_id );

                if ( ! $variation ) {
                    continue;
                }

                $description = get_post_meta(
                    $variation_id,
                    '_gamenet_var_description',
                    true
                );

                if ( $description === '' ) {
                    $description = $variation->get_description();
                }

                $result[ $variation_id ] = [

                    'id' => $variation_id,

                    'title' => $variation->get_name(),

                    'price' => (float) $variation->get_price(),

                    'regular_price' => (float) $variation->get_regular_price(),

                    'sale_price' => (float) $variation->get_sale_price(),

                    'capacity' => lobix_product_get_capacity(
                        $variation_id,
                        $product_id
                    ),

                    'description' => $description ?: '',

                    'system_numbers' => lobix_reservation_get_system_numbers(
                        $variation_id
                    ),

                    'games' => lobix_reservation_get_allowed_games(
                        $product_id,
                        $variation_id
                    ),

                ];
            }

        } else {

            $result[0] = [

                'id' => 0,

                'title' => $product->get_name(),

                'price' => (float) $product->get_price(),

                'regular_price' => (float) $product->get_regular_price(),

                'sale_price' => (float) $product->get_sale_price(),

                'capacity' => lobix_product_get_capacity(
                    0,
                    $product_id
                ),

                'description' => get_post_meta(
                    $product_id,
                    '_gamenet_var_description',
                    true
                ),

                'system_numbers' => [],

                'games' => [],

            ];
        }

        return $result;
    }
}

/* ============================================================
 * 10. BUILD BOOKED SLOTS
 *
 * سازگار با شمارش رزروهای قبلی و رزرو دستگاه فیزیکی.
 *
 * ساختار قبلی حفظ می‌شود:
 * $booked[date][hour][variation_id] = تعداد رزرو
 *
 * ساختار جدید:
 * $booked[date][hour]['_physical'][variation_id][system_number] = true
 * $booked[date][hour]['_physical_games'][variation_id][system_number] = game_id
 * ============================================================ */

if ( ! function_exists( 'lobix_product_get_booked_slots' ) ) {

    function lobix_product_get_booked_slots(
        $product_id,
        $from_date = '',
        $days = 14
    ) {

        $product_id = absint( $product_id );

        $days = max(
            1,
            min( 120, absint( $days ) )
        );

        if (
            ! preg_match(
                '/^\d{4}-\d{2}-\d{2}$/',
                $from_date
            )
        ) {
            $now = new DateTimeImmutable(
                'now',
                wp_timezone()
            );

            $from_date = $now->format( 'Y-m-d' );
        }

        try {
            $from = new DateTimeImmutable(
                $from_date . ' 00:00:00',
                wp_timezone()
            );
        } catch ( Exception $e ) {
            return [];
        }

        $to = $from->modify(
            '+' . ( $days - 1 ) . ' days'
        );

        $to_date = $to->format( 'Y-m-d' );

        $booked = [];

        /*
         * ثبت تعداد رزرو و شماره دستگاه.
         * شمارش قدیمی بدون شماره دستگاه نیز حفظ می‌شود.
         */

        $add_booking = function (
            $date_iso,
            $hour,
            $variation_id,
            $quantity = 1,
            $system_number = '',
            $game_id = 0,
            $system_id = '',
            $booking_start = null,
            $booking_hours = 1
        ) use ( &$booked ) {

            $date_iso = (string) $date_iso;
            $hour = absint( $hour );
            $variation_id = absint( $variation_id );
            $quantity = max( 1, absint( $quantity ) );

            if (
                ! $variation_id ||
                $hour > 23 ||
                ! preg_match(
                    '/^\d{4}-\d{2}-\d{2}$/',
                    $date_iso
                )
            ) {
                return;
            }

            if ( ! isset( $booked[ $date_iso ] ) ) {
                $booked[ $date_iso ] = [];
            }

            if ( ! isset( $booked[ $date_iso ][ $hour ] ) ) {
                $booked[ $date_iso ][ $hour ] = [];
            }

            if (
                ! isset(
                    $booked[ $date_iso ][ $hour ][ $variation_id ]
                )
            ) {
                $booked[ $date_iso ][ $hour ][ $variation_id ] = 0;
            }

            $booked[ $date_iso ][ $hour ][ $variation_id ] += $quantity;

            /* شناسه پایدار دستگاه مستقل از شماره ذخیره می‌شود. */
            $system_id = is_scalar( $system_id )
                ? sanitize_text_field( trim( (string) $system_id ) )
                : '';

            if ( $system_id !== '' ) {
                if ( ! isset( $booked[ $date_iso ][ $hour ]['_physical_ids'][ $variation_id ] ) ) {
                    $booked[ $date_iso ][ $hour ]['_physical_ids'][ $variation_id ] = [];
                }
                $booked[ $date_iso ][ $hour ]['_physical_ids'][ $variation_id ][ $system_id ] = true;
            }

            $range_start = $booking_start === null ? $hour : absint( $booking_start );
            $range_hours = max( 1, absint( $booking_hours ) );
            if ( $hour === $range_start ) {
                $range = array( 'start' => $range_start, 'hours' => $range_hours );
                if ( $system_id !== '' ) {
                    if ( ! isset( $booked[ $date_iso ]['_physical_ranges'][ $variation_id ]['id'][ $system_id ] ) ) {
                        $booked[ $date_iso ]['_physical_ranges'][ $variation_id ]['id'][ $system_id ] = array();
                    }
                    $booked[ $date_iso ]['_physical_ranges'][ $variation_id ]['id'][ $system_id ][] = $range;
                }
                if ( is_scalar( $system_number ) && trim( (string) $system_number ) !== '' ) {
                    $range_number = trim( (string) $system_number );
                    if ( ! isset( $booked[ $date_iso ]['_physical_ranges'][ $variation_id ]['number'][ $range_number ] ) ) {
                        $booked[ $date_iso ]['_physical_ranges'][ $variation_id ]['number'][ $range_number ] = array();
                    }
                    $booked[ $date_iso ]['_physical_ranges'][ $variation_id ]['number'][ $range_number ][] = $range;
                }
                if ( $system_id === '' && ( ! is_scalar( $system_number ) || trim( (string) $system_number ) === '' ) ) {
                    if ( ! isset( $booked[ $date_iso ]['_legacy_ranges'][ $variation_id ] ) ) {
                        $booked[ $date_iso ]['_legacy_ranges'][ $variation_id ] = array();
                    }
                    $booked[ $date_iso ]['_legacy_ranges'][ $variation_id ][] = $range;
                }
            }

            /* شماره دستگاه برای سازگاری با رزروهای قدیمی و API ویندوز حفظ می‌شود. */
            if (
                is_scalar( $system_number ) &&
                trim( (string) $system_number ) !== ''
            ) {
                $system_number = trim(
                    (string) $system_number
                );

                if (
                    ! isset(
                        $booked[ $date_iso ][ $hour ]['_physical']
                    )
                ) {
                    $booked[ $date_iso ][ $hour ]['_physical'] = [];
                }

                if (
                    ! isset(
                        $booked[ $date_iso ][ $hour ]['_physical'][ $variation_id ]
                    )
                ) {
                    $booked[ $date_iso ][ $hour ]['_physical'][ $variation_id ] = [];
                }

                $booked[ $date_iso ][ $hour ]['_physical']
                    [ $variation_id ][ $system_number ] = true;

                if ( $game_id > 0 ) {

                    if (
                        ! isset(
                            $booked[ $date_iso ][ $hour ]['_physical_games']
                        )
                    ) {
                        $booked[ $date_iso ][ $hour ]['_physical_games'] = [];
                    }

                    if (
                        ! isset(
                            $booked[ $date_iso ][ $hour ]['_physical_games']
                                [ $variation_id ]
                        )
                    ) {
                        $booked[ $date_iso ][ $hour ]['_physical_games']
                            [ $variation_id ] = [];
                    }

                    $booked[ $date_iso ][ $hour ]['_physical_games']
                        [ $variation_id ][ $system_number ] = $game_id;
                }
            }
        };

        /*
         * =====================================================
         * ONLINE ORDERS
         * =====================================================
         */

        $page = 1;
        $page_size = 100;
        do {
            $orders = wc_get_orders(
                [
                    'limit'    => $page_size,
                    'page'     => $page,
                    'paginate' => false,
                    'status'   => [ 'processing', 'completed', 'on-hold' ],
                    'product'  => [ $product_id ],
                    'return'   => 'objects',
                    'orderby'  => 'date',
                    'order'    => 'DESC',
                ]
            );

            foreach ( (array) $orders as $order ) {

            if ( ! $order instanceof WC_Order ) {
                continue;
            }

            foreach ( $order->get_items( 'line_item' ) as $item ) {

                if (
                    absint( $item->get_product_id() ) !== $product_id
                ) {
                    continue;
                }

                $variation_id = absint(
                    $item->get_variation_id()
                );

                if ( ! $variation_id ) {
                    continue;
                }

                $booking = lobix_product_parse_order_item_booking(
                    $item
                );

                if (
                    empty( $booking['date_iso'] ) ||
                    ! isset( $booking['start'] ) ||
                    $booking['start'] === null ||
                    empty( $booking['hours'] )
                ) {
                    continue;
                }

                if (
                    $booking['date_iso'] < $from_date ||
                    $booking['date_iso'] > $to_date
                ) {
                    continue;
                }

                $quantity = max(
                    1,
                    absint( $item->get_quantity() )
                );

                /*
                 * این کلیدها در بخش ثبت سفارش استفاده خواهند شد.
                 * برای سفارش‌های قدیمی ممکن است خالی باشند.
                 */

                $system_number = $item->get_meta(
                    '_lx_system_number',
                    true
                );

                if (
                    $system_number === '' ||
                    $system_number === null
                ) {
                    $system_number = $item->get_meta(
                        'lx_system_number',
                        true
                    );
                }

                $system_id = sanitize_text_field( (string) $item->get_meta( '_lx_system_id', true ) );
                if ( $system_id === '' ) {
                    $system_id = sanitize_text_field( (string) $item->get_meta( 'lx_system_id', true ) );
                }

                $game_id = absint(
                    $item->get_meta( '_lx_game_id', true )
                );

                if ( ! $game_id ) {
                    $game_id = absint(
                        $item->get_meta( 'lx_game_id', true )
                    );
                }

                for (
                    $i = 0;
                    $i < absint( $booking['hours'] );
                    $i++
                ) {

                    $hour = absint( $booking['start'] ) + $i;

                    if ( $hour > 23 ) {
                        break;
                    }

                    $add_booking(
                        $booking['date_iso'],
                        $hour,
                        $variation_id,
                        $quantity,
                        $system_number,
                        $game_id,
                        $system_id,
                        $booking['start'],
                        $booking['hours']
                    );
                }
            }
            }
            $has_more_orders = is_array( $orders ) && count( $orders ) === $page_size;
            $page++;
        } while ( $has_more_orders && $page <= 1001 );

        /*
         * =====================================================
         * MANUAL BOOKINGS
         * =====================================================
         */

        $manual_bookings = lobix_product_get_manual_bookings(
            $product_id
        );

        if ( ! empty( $manual_bookings ) ) {

            $product = wc_get_product( $product_id );

            $valid_variations = [];

            if (
                $product &&
                $product->is_type( 'variable' )
            ) {
                $valid_variations = array_map(
                    'absint',
                    $product->get_children()
                );
            }

            for ( $i = 0; $i < $days; $i++ ) {

                $date = $from->modify( '+' . $i . ' days' );

                $date_iso = $date->format( 'Y-m-d' );

                foreach ( $manual_bookings as $booking ) {

                    if ( ! is_array( $booking ) ) {
                        continue;
                    }

                    $variation_id = isset( $booking['var_id'] )
                        ? absint( $booking['var_id'] )
                        : 0;

                    if ( ! $variation_id ) {
                        continue;
                    }

                    if (
                        ! empty( $valid_variations ) &&
                        ! in_array(
                            $variation_id,
                            $valid_variations,
                            true
                        )
                    ) {
                        continue;
                    }

                    $hour = isset( $booking['hour'] )
                        ? absint( $booking['hour'] )
                        : -1;

                    if ( $hour < 0 || $hour > 23 ) {
                        continue;
                    }

                    if (
                        ! lobix_product_manual_booking_matches_slot(
                            $booking,
                            $date_iso,
                            $hour
                        )
                    ) {
                        continue;
                    }

                    $quantity = (
                        isset( $booking['quantity'] ) &&
                        is_numeric( $booking['quantity'] )
                    )
                        ? max( 1, absint( $booking['quantity'] ) )
                        : 1;

                    /*
                     * پشتیبانی از نام‌های متداول فیلد شماره دستگاه
                     * در رزروهای دستی.
                     */

                    $system_number = '';

                    foreach (
                        [
                            'system_number',
                            'system_no',
                            'device_number',
                            'system',
                        ] as $system_key
                    ) {
                        if (
                            isset( $booking[ $system_key ] ) &&
                            is_scalar( $booking[ $system_key ] ) &&
                            trim(
                                (string) $booking[ $system_key ]
                            ) !== ''
                        ) {
                            $system_number = trim(
                                (string) $booking[ $system_key ]
                            );

                            break;
                        }
                    }

                    $system_id = '';
                    foreach ( [ 'system_id', 'physical_system_id', 'device_id' ] as $system_id_key ) {
                        if ( isset( $booking[ $system_id_key ] ) && is_scalar( $booking[ $system_id_key ] ) ) {
                            $system_id = sanitize_text_field( trim( (string) $booking[ $system_id_key ] ) );
                            if ( $system_id !== '' ) break;
                        }
                    }

                    $game_id = 0;

                    foreach (
                        [ 'game_id', 'lobix_game_id' ] as $game_key
                    ) {
                        if (
                            isset( $booking[ $game_key ] )
                        ) {
                            $game_id = absint(
                                $booking[ $game_key ]
                            );

                            if ( $game_id ) {
                                break;
                            }
                        }
                    }

                    $add_booking(
                        $date_iso,
                        $hour,
                        $variation_id,
                        $quantity,
                        $system_number,
                        $game_id,
                        $system_id,
                        $hour,
                        1
                    );
                }
            }
        }

        return $booked;
    }
}

