            /* =================================================
             * RESERVATION DRAFT PERSISTENCE
             * Keep date, time, duration, devices and per-device games
             * across a same-tab browser refresh.
             * ================================================= */
            function persistReservationDraft() {
                try {
                    const selected = [];
                    $rows.each(function () {
                        const $row = $(this);
                        $row.find('.lx-device-check:checked').each(function () {
                            const $checkbox = $(this);
                            const $option = $checkbox.closest('.lx-device-option');
                            selected.push({
                                variation_id: String($row.attr('data-variant-id') || ''),
                                system_number: String($checkbox.attr('data-system-number') || ''),
                                system_id: String($checkbox.attr('data-system-id') || ''),
                                game_id: String($option.find('.lx-device-game').val() || '')
                            });
                        });
                    });
                    const draft = {
                        version: 1,
                        date_iso: getSelectedDate(),
                        hour: getSelectedTimeHour(),
                        hours: Math.max(1, parseInt($hoursInput.val(), 10) || 1),
                        selected: selected,
                        saved_at: Date.now()
                    };
                    sessionStorage.setItem(reservationDraftStorageKey, JSON.stringify(draft));
                } catch (e) {
                    // Private browsing or blocked storage must not break booking.
                }
            }

            function restoreReservationDraft() {
                try {
                    const raw = sessionStorage.getItem(reservationDraftStorageKey);
                    if (!raw) return false;
                    const draft = JSON.parse(raw);
                    if (!draft || draft.version !== 1 || !Array.isArray(draft.selected)) return false;
                    if (draft.saved_at && (Date.now() - Number(draft.saved_at)) > (2 * 60 * 60 * 1000)) {
                        sessionStorage.removeItem(reservationDraftStorageKey);
                        return false;
                    }
                    const $date = $('.lx-date-card').filter(function () {
                        return String($(this).attr('data-iso') || '') === String(draft.date_iso || '');
                    }).first();
                    if (!$date.length) {
                        sessionStorage.removeItem(reservationDraftStorageKey);
                        return false;
                    }
                    $('.lx-date-card').removeClass('active');
                    $date.addClass('active');
                    if (draft.hour !== null && draft.hour !== undefined) {
                        const $time = $('.lx-time-card').filter(function () {
                            return parseInt($(this).attr('data-hour'), 10) === parseInt(draft.hour, 10);
                        }).first();
                        if ($time.length) {
                            $('.lx-time-card').removeClass('active');
                            $time.addClass('active');
                        }
                    }
                    $hoursInput.val(Math.max(1, Math.min(24, parseInt(draft.hours, 10) || 1)));
                    pendingReservationDraft = draft;
                    return true;
                } catch (e) {
                    pendingReservationDraft = null;
                    return false;
                }
            }

            function applyPendingReservationDraft() {
                if (!initialAvailabilityReady || !pendingReservationDraft) return;
                const draft = pendingReservationDraft;
                pendingReservationDraft = null;
                (draft.selected || []).forEach(function (saved) {
                    const $row = $rows.filter(function () {
                        return String($(this).attr('data-variant-id') || '') === String(saved.variation_id || '');
                    }).first();
                    if (!$row.length) return;
                    let $checkbox = $();
                    if (saved.system_id) {
                        $checkbox = $row.find('.lx-device-check').filter(function () {
                            return String($(this).attr('data-system-id') || '') === String(saved.system_id);
                        }).first();
                    } else {
                        $checkbox = $row.find('.lx-device-check').filter(function () {
                            return String($(this).attr('data-system-number') || '') === String(saved.system_number || '');
                        }).first();
                    }
                    if (!$checkbox.length || $checkbox.prop('disabled')) return;
                    $checkbox.prop('checked', true).trigger('change');
                    const $game = $checkbox.closest('.lx-device-option').find('.lx-device-game');
                    if (saved.game_id) {
                        $game.val(String(saved.game_id)).trigger('change');
                    }
                });
                persistReservationDraft();
            }

            /* =================================================
             * MAX AVAILABLE
             *
             * ظرفیت در تمام ساعات مدت رزرو.
             * ================================================= */

            function getMaxAvailableForWindow(
                variationId,
                startHour,
                duration,
                capacity,
                dateIso
            ) {

                let minAvailable =
                    capacity;

                for (
                    let h = startHour;
                    h < startHour + duration;
                    h++
                ) {

                    const booked =
                        getBooked(
                            dateIso,
                            h,
                            variationId
                        );

                    const available =
                        Math.max(
                            0,
                            capacity - booked
                        );

                    minAvailable =
                        Math.min(
                            minAvailable,
                            available
                        );
                }

                return Math.max(
                    0,
                    minAvailable
                );
            }


