            /* =================================================
             * SERVER REFRESH
             * ================================================= */

            function refreshAvailabilityFromServer(
                callback
            ) {

                if ( refreshing ) {
                    if ( typeof callback === 'function' ) availabilityWaiters.push( callback );
                    return;
                }

                refreshing = true;

                if (
                    availabilityRequest &&
                    availabilityRequest.readyState !== 4
                ) {

                    availabilityRequest.abort();
                }

                availabilityRequest =
                    $.ajax({

                        url:
                            ajaxUrl,

                        type:
                            'POST',

                        dataType:
                            'json',

                        data: {

                            action:
                                'lobix_product_availability',

                            product_id:
                                productId,

                            nonce:
                                nonce,

                        }

                    })
                    .done(
                        function(response) {

                            if (
                                !response ||
                                !response.success ||
                                !response.data
                            ) {

                                if (
                                    typeof callback ===
                                    'function'
                                ) {

                                    callback(false);
                                }

                                return;
                            }

                            const data =
                                response.data;

                            const oldStart =
                                workStart;

                            const oldEnd =
                                workEnd;

                            const oldMode =
                                bookingMode;

                            const oldStock =
                                stockStatus;


                            workStart =
                                parseInt(
                                    data.settings.work_start,
                                    10
                                );

                            workEnd =
                                parseInt(
                                    data.settings.work_end,
                                    10
                                );

                            bookingMode =
                                String(
                                    data.settings.booking_mode ||
                                    'auto'
                                );

                            stockStatus =
                                String(
                                    data.settings.stock_status ||
                                    'instock'
                                );

                            bookedSlots =
                                data.booked ||
                                {};


                            /*
                             * حالت رزرو.
                             */

                            if (
                                bookingMode ===
                                'manual'
                            ) {

                                $submitBtn
                                    .prop(
                                        'disabled',
                                        true
                                    )
                                    .text(
                                        'رزرو آنلاین غیرفعال است'
                                    );

                            } else if (
                                stockStatus ===
                                'outofstock'
                            ) {

                                $submitBtn
                                    .prop(
                                        'disabled',
                                        true
                                    )
                                    .text(
                                        'رزرو فعلاً غیرفعال است'
                                    );

                            } else {

                                $submitBtn
                                    .prop(
                                        'disabled',
                                        false
                                    )
                                    .text(
                                        'ادامه رزرو و پرداخت'
                                    )
                                    .css(
                                        'opacity',
                                        '1'
                                    );
                            }


                            /*
                             * ساعت کاری تغییر کرده؟
                             */

                            if (
                                oldStart !==
                                workStart ||
                                oldEnd !==
                                workEnd
                            ) {

                                rebuildWorkHours();
                            }


                            /*
                             * ظرفیت و قیمت.
                             */

                            Object.keys(
                                data.variations ||
                                {}
                            ).forEach(
                                function(id) {

                                    const $row =
                                        $(
                                            '.lx-system-row[data-variant-id="' +
                                            id +
                                            '"]'
                                        );

                                    if (
                                        !$row.length
                                    ) {
                                        return;
                                    }

                                    const capacity =
                                        parseInt(
                                            data
                                                .variations[
                                                    id
                                                ]
                                                .capacity,
                                            10
                                        ) || 1;

                                    const price =
                                        parseFloat(
                                            data
                                                .variations[
                                                    id
                                                ]
                                                .price
                                        ) || 0;

                                    $row
                                        .attr(
                                            'data-capacity',
                                            capacity
                                        )
                                        .data(
                                            'capacity',
                                            capacity
                                        )
                                        .attr(
                                            'data-max-stock',
                                            capacity
                                        )
                                        .data(
                                            'max-stock',
                                            capacity
                                        )
                                        .attr(
                                            'data-price',
                                            price
                                        )
                                        .data(
                                            'price',
                                            price
                                        );

                                    $row
                                        .find(
                                            '.lx-capacity-info'
                                        )
                                        .text(
                                            'ظرفیت: ' +
                                            capacity.toLocaleString(
                                                'fa-IR'
                                            ) +
                                            ' سیستم'
                                        );
                                }
                            );


                            /*
                             * اگر وضعیت تغییر کرده،
                             * پیام واضح.
                             */

                            if (
                                oldMode !==
                                    bookingMode ||
                                oldStock !==
                                    stockStatus
                            ) {

                                if (
                                    bookingMode ===
                                    'manual'
                                ) {

                                    showMessage(
                                        'این گیمنت در حالت رزرو دستی قرار گرفت.'
                                    );

                                } else if (
                                    stockStatus ===
                                    'outofstock'
                                ) {

                                    showMessage(
                                        'رزرو این گیمنت موقتاً غیرفعال شد.'
                                    );
                                }
                            }


                            validateAvailability();
                            updatePrice();


                            availabilityLastResult = true;

                        }
                    )
                    .fail(
                        function() {

                            availabilityLastResult = false;
                        }
                    )
                    .always(function() {
                        refreshing = false;
                        const callbacks = availabilityWaiters.splice(0);
                        if ( typeof callback === 'function' ) {
                            try { callback( availabilityLastResult ); } catch (e) { console.error('Lobix availability callback:', e); }
                        }
                        callbacks.forEach(function(waiter) {
                            try { waiter( availabilityLastResult ); } catch (e) { console.error('Lobix availability callback:', e); }
                        });
                    });
            }


