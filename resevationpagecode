            );

        } else {

            showMessage(
                'ظرفیت انتخاب‌شده در این بازه تکمیل شده است.'
            );
        }

        validateAvailability();
        return;
    }

                            /*
                             * انتقال اطلاعات به PHP.
                             */

                            $('#lx-hidden-hours')
                                .val(
                                    duration
                                );

                            $('#lx-hidden-time')
