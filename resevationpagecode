function updateBookingMapZoom() {
    const width = bookingMapNativeSize.width || 1000;
    const height = bookingMapNativeSize.height || 700;
    const scale = Math.max(0.5, Math.min(2.5, bookingMapZoom));
    bookingMapZoom = scale;
    $bookingMapCanvas.css({ transform: 'scale(' + scale + ')', transformOrigin: 'top left' });
    $bookingMapZoomStage.css({ width: (width * scale) + 'px', height: (height * scale) + 'px', position: 'relative' });
    $bookingMap.find('[data-role="map-zoom-label"]').text(Math.round(scale * 100).toLocaleString('fa-IR') + '٪');
}
function changeBookingMapZoom(delta, clientX, clientY) {
    const old = bookingMapZoom;
    const next = Math.max(0.5, Math.min(2.5, old + delta));
    if (next === old) return;
    if (Number.isFinite(clientX) && Number.isFinite(clientY)) {
        const rect = $bookingMapViewport.get(0).getBoundingClientRect();
        const px = clientX - rect.left + $bookingMapViewport.scrollLeft;
        const py = clientY - rect.top + $bookingMapViewport.scrollTop;
        const ratio = next / old;
        updateBookingMapZoomTo(next);
        $bookingMapViewport.scrollLeft = Math.max(0, px * ratio - (clientX - rect.left));
        $bookingMapViewport.scrollTop = Math.max(0, py * ratio - (clientY - rect.top));
    } else updateBookingMapZoomTo(next);
}
function updateBookingMapZoomTo(value) { bookingMapZoom = value; updateBookingMapZoom(); }
$bookingMap.on('click', '[data-action="map-zoom-in"]', function () { changeBookingMapZoom(0.2); });
$bookingMap.on('click', '[data-action="map-zoom-out"]', function () { changeBookingMapZoom(-0.2); });
$bookingMap.on('click', '[data-action="map-zoom-reset"]', function () { updateBookingMapZoomTo(1); $bookingMapViewport.scrollLeft(0).scrollTop(0); });
$bookingMapViewport.on('wheel', function (event) {
    if (!event.originalEvent) return;
    const e = event.originalEvent;
    // Trackpad two-finger scroll pans the map normally. Pinch gestures on
    // macOS are exposed as ctrl/meta + wheel and are reserved for zooming.
    // A physical mouse can use Option/Alt + wheel to zoom as well.
    if (e.ctrlKey || e.metaKey || e.altKey) {
        event.preventDefault();
        changeBookingMapZoom(e.deltaY < 0 ? 0.12 : -0.12, e.clientX, e.clientY);
    }
});
// Pinch-to-zoom on touch screens; ordinary one-finger movement remains map scrolling.
(function bindMapPinchZoom() {
    const viewport = $bookingMapViewport.get(0);
    if (!viewport) return;
    let pinchStart = 0, pinchZoom = 1;
    viewport.addEventListener('touchstart', function (e) {
        if (e.touches && e.touches.length === 2) {
            const dx = e.touches[0].clientX - e.touches[1].clientX;
            const dy = e.touches[0].clientY - e.touches[1].clientY;
            pinchStart = Math.hypot(dx, dy); pinchZoom = bookingMapZoom;
        }
    }, { passive: true });
    viewport.addEventListener('touchmove', function (e) {
        if (!e.touches || e.touches.length !== 2 || !pinchStart) return;
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        const distance = Math.hypot(dx, dy);
        if (distance > 0) { e.preventDefault(); updateBookingMapZoomTo(pinchZoom * distance / pinchStart); }
    }, { passive: false });
    ['touchend', 'touchcancel'].forEach(function (name) {
        viewport.addEventListener(name, function (e) { if (!e.touches || e.touches.length < 2) pinchStart = 0; }, { passive: true });
    });
})();

function renderBookingMap(response) {
    const data = response && response.success === true ? response.data : null;
    if (!data || !data.layout || !Array.isArray(data.layout.objects) || !Array.isArray(data.devices)) {
        $bookingMapMessage.text((data && data.message) || 'اطلاعات نقشه معتبر نیست.');
        return;
    }
    const layout = data.layout;
    const layoutWidth = Math.max(200, Number(layout.width) || 1000);
    const layoutHeight = Math.max(200, Number(layout.height) || 700);

    // Replace only the live status data on routine polls. Rebuilding the DOM
    // every 15 seconds caused a visible flash and reset the user's zoom/pan.
    bookingMapDevicesById = Object.create(null);
    data.devices.forEach(function (device) {
        if (device && device.system_id) bookingMapDevicesById[String(device.system_id)] = device;
    });
    bookingMapHasRegistry = data.has_registry === true;

    const layoutSignature = JSON.stringify([layoutWidth, layoutHeight, activeMapVariantId, layout.objects]);
    const sameLayout = layoutSignature === lastBookingMapLayoutSignature &&
        $bookingMapCanvas.children().length > 0;

    function getTilePresentation(systemId, objectLabel) {
        const device = systemId ? bookingMapDevicesById[systemId] : null;
        let state = 'unknown';
        let statusText = 'وضعیت نامشخص';
        const belongsToActiveVariant = !!(
            device && activeMapVariantId &&
            Number(device.variation_id) === Number(activeMapVariantId)
        );
        if (device && activeMapVariantId && !belongsToActiveVariant) {
            state = 'other-category';
            statusText = 'بخش دیگر';
        } else if (device) {
            if (device.active !== true || device.status === 'off') { state = 'off'; statusText = 'غیرفعال'; }
            else if (device.status === 'free') { state = 'free'; statusText = 'آزاد'; }
            else if (device.status === 'reserved') { state = 'reserved'; statusText = 'رزرو شده'; }
            else if (device.status === 'in_use') { state = 'in-use'; statusText = 'در حال استفاده'; }
        }
        return {
            state: state,
            statusText: statusText,
            label: String(objectLabel || (device && device.label) || 'سیستم')
        };
    }

    if (sameLayout) {
        $bookingMapCanvas.find('.lx-map-system[data-system-id]').each(function () {
            const $tile = $(this);
            const systemId = String($tile.attr('data-system-id') || '');
            const view = getTilePresentation(systemId, $tile.find('strong').text());
            $tile.removeClass(function (_index, className) {
                return (className.match(/\blx-map-system--[\w-]+/g) || []).join(' ');
            }).addClass('lx-map-system lx-map-system--' + view.state)
                .attr('title', view.label + ' — ' + view.statusText)
                .attr('aria-label', view.label + '، ' + view.statusText)
                .prop('disabled', view.state !== 'free' || !systemId);
            $tile.find('strong').text(view.label);
            $tile.find('small').text(view.statusText);
        });
        $bookingMapMessage.text('وضعیت ' + data.devices.length.toLocaleString('fa-IR') + ' دستگاه برای این بازه بررسی شد.');
        applyMapAvailabilityToPickers();
        applyPendingReservationDraft();
        return;
    }

    // Layout changed (or this is the first load): rebuild once, while keeping
    // the current zoom and scroll position instead of snapping back to 100%.
    const previousZoom = bookingMapZoom;
    const previousScrollLeft = $bookingMapViewport.scrollLeft();
    const previousScrollTop = $bookingMapViewport.scrollTop();
    bookingMapNativeSize = { width: layoutWidth, height: layoutHeight };
    $bookingMapCanvas.empty().css({
        width: layoutWidth + 'px',
        height: layoutHeight + 'px',
        minWidth: '0', minHeight: '0', aspectRatio: 'auto',
        transformOrigin: 'top left'
    });

    if (!layout.objects.length) {
        lastBookingMapLayoutSignature = layoutSignature;
        updateBookingMapZoomTo(previousZoom);
        $bookingMapMessage.text('برای این گیمنت هنوز چیدمان نقشه ثبت نشده است؛ انتخاب دستگاه از فهرست همچنان فعال است.');
        applyMapAvailabilityToPickers();
        applyPendingReservationDraft();
        return;
    }

    layout.objects.forEach(function (object) {
        if (!object || typeof object !== 'object') return;
        const x = Number(object.x) || 0;
        const y = Number(object.y) || 0;
        const width = Math.max(1, Number(object.width) || 1);
        const height = Math.max(1, Number(object.height) || 1);
        const rotation = Number(object.rotation) || 0;
        const position = {
            left: x + 'px', top: y + 'px', width: width + 'px', height: height + 'px',
            transform: rotation ? 'rotate(' + rotation + 'deg)' : 'none',
            transformOrigin: 'center center', boxSizing: 'border-box'
        };
        if (object.type === 'section' || object.type === 'room' || object.type === 'area') {
            $('<div></div>').addClass('lx-map-section').css(position).text(object.label || 'ناحیه').appendTo($bookingMapCanvas);
            return;
        }
        if (object.type !== 'system') {
            const safeType = String(object.type || 'object').replace(/[^a-z0-9_-]/gi, '');
            $('<div></div>').addClass('lx-map-object lx-map-object--' + safeType).css(position).text(object.label || '').appendTo($bookingMapCanvas);
            return;
        }
        const systemId = String(object.system_id || '');
        const view = getTilePresentation(systemId, object.label);
        const $tile = $('<button type="button"></button>')
            .addClass('lx-map-system lx-map-system--' + view.state)
            .css(position)
            .attr('title', view.label + ' — ' + view.statusText)
            .attr('aria-label', view.label + '، ' + view.statusText)
            .prop('disabled', view.state !== 'free' || !systemId)
            .attr('data-system-id', systemId);
        $('<strong></strong>').text(view.label).appendTo($tile);
        $('<small></small>').text(view.statusText).appendTo($tile);
        $bookingMapCanvas.append($tile);
    });

    lastBookingMapLayoutSignature = layoutSignature;
    updateBookingMapZoomTo(previousZoom);
    window.requestAnimationFrame(function () {
        $bookingMapViewport.scrollLeft(previousScrollLeft).scrollTop(previousScrollTop);
    });
    $bookingMapMessage.text('وضعیت ' + data.devices.length.toLocaleString('fa-IR') + ' دستگاه برای این بازه بررسی شد.');
    applyMapAvailabilityToPickers();
    applyPendingReservationDraft();
}
function refreshBookingMap() {
    if (!activeMapVariantId || !$bookingMap.hasClass('is-visible')) return;
    const dateIso = getSelectedDate();
    const selectedHour = getSelectedTimeHour();
    if (!dateIso || selectedHour === null) {
        if (bookingMapRequest && bookingMapRequest.readyState !== 4) bookingMapRequest.abort();
        bookingMapRequestSeq++;
        $bookingMapCanvas.empty();
        $bookingMapMessage.text('برای مشاهده وضعیت دستگاه‌ها، تاریخ و ساعت شروع را انتخاب کنید.');
        bookingMapDevicesById = Object.create(null);
        bookingMapHasRegistry = false;
        return;
    }
    const hours = Math.max(1, Math.min(24, parseInt($hoursInput.val(), 10) || 1));
    const startTime = String(selectedHour).padStart(2, '0') + ':00';
    const requestSeq = ++bookingMapRequestSeq;
    if (bookingMapRequest && bookingMapRequest.readyState !== 4) bookingMapRequest.abort();
    bookingMapRequest = $.ajax({
        url: ajaxUrl,
        type: 'POST',
        dataType: 'json',
        cache: false,
        data: {
            action: bookingMapAjaxAction,
            product_id: productId,
            date_iso: dateIso,
            start_time: startTime,
            hours: hours,
            nonce: nonce
        }
    }).done(function (response) {
        if (requestSeq !== bookingMapRequestSeq) return;
        renderBookingMap(response);
    }).fail(function (xhr, status) {
        if (status === 'abort' || requestSeq !== bookingMapRequestSeq) return;
        $bookingMapMessage.text('دریافت وضعیت نقشه ناموفق بود؛ فهرست دستگاه‌ها همچنان در دسترس است.');
        applyPendingReservationDraft();
        console.error('Lobix booking map AJAX error:', xhr.responseText || status);
    });
}

