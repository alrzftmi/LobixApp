);

if ( ! function_exists( 'lobix_product_handle_reservation_submit' ) ) {

    function lobix_product_handle_reservation_submit() {

        /*
         * بررسی درخواست فرم
         */

        if (
            ! isset(
                $_POST['lx_reservation_submit'],
                $_POST['lx_reservation_nonce']
            )
        ) {
            return;
        }

        if (
            ! wp_verify_nonce(
                sanitize_text_field(
                    wp_unslash( $_POST['lx_reservation_nonce'] )
                ),
                'lx_reservation_submit_action'
            )
        ) {
            wc_add_notice(
                'درخواست رزرو معتبر نیست. صفحه را تازه‌سازی کنید.',
                'error'
            );
            return;
        }

        if ( ! function_exists( 'WC' ) || ! WC()->cart ) {
            wc_add_notice(
                'سبد خرید در دسترس نیست.',
                'error'
            );
            return;
        }

        /*
         * دریافت اطلاعات فرم
         */

        $product_id = isset( $_POST['product_id'] )
            ? absint( $_POST['product_id'] )
            : 0;

        $systems_json = isset( $_POST['systems'] )
            ? wp_unslash( $_POST['systems'] )
            : '';

        $systems = json_decode( $systems_json, true );

        $hours = isset( $_POST['hours'] )
            ? absint( $_POST['hours'] )
            : 0;

        $time = isset( $_POST['time'] )
            ? sanitize_text_field(
                wp_unslash( $_POST['time'] )
            )
            : '';

        $date = isset( $_POST['date'] )
            ? sanitize_text_field(
                wp_unslash( $_POST['date'] )
            )
            : '';

        $date_iso = isset( $_POST['date_iso'] )
            ? sanitize_text_field(
                wp_unslash( $_POST['date_iso'] )
            )
            : '';

        $product = wc_get_product( $product_id );

        if (
            ! $product ||
            ! $product->is_type( 'variable' ) ||
            ! is_array( $systems ) ||
            empty( $systems ) ||
            count( $systems ) > 100
        ) {
            wc_add_notice(
                'اطلاعات رزرو نامعتبر است.',
                'error'
            );
            return;
        }

        /*
         * قفل کوتاه‌مدت هم‌نام با قفل API 2.4.2؛ برای جلوگیری از ثبت هم‌زمان
         * رزرو آنلاین با رزرو/ویرایش دستی API روی همان دیتابیس.
         */
        global $wpdb;
        $lobix_booking_lock_name = 'lbxop_' . substr( md5( (string) absint( $product_id ) ), 0, 32 );
        $lobix_booking_lock_result = $wpdb->get_var( $wpdb->prepare( 'SELECT GET_LOCK(%s, %d)', $lobix_booking_lock_name, 15 ) );
        if ( (string) $lobix_booking_lock_result !== '1' ) {
            wc_add_notice( 'ثبت رزرو دیگری در حال انجام است؛ چند لحظه بعد دوباره تلاش کنید.', 'error' );
            return;
        }
        register_shutdown_function( function() use ( $wpdb, $lobix_booking_lock_name ) {
            $wpdb->get_var( $wpdb->prepare( 'SELECT RELEASE_LOCK(%s)', $lobix_booking_lock_name ) );
        } );

        /*
         * اعتبارسنجی مدت رزرو
         */

        if ( $hours < 1 || $hours > 24 ) {
            wc_add_notice(
                'مدت رزرو نامعتبر است.',
                'error'
            );
            return;
        }

        /*
         * اعتبارسنجی تاریخ
         */

        if (
            ! preg_match(
                '/^\d{4}-\d{2}-\d{2}$/',
                $date_iso
            )
        ) {
            wc_add_notice(
                'تاریخ رزرو نامعتبر است.',
                'error'
            );
            return;
        }

        $date_parts = explode( '-', $date_iso );

        if (
            count( $date_parts ) !== 3 ||
            ! checkdate(
                (int) $date_parts[1],
                (int) $date_parts[2],
                (int) $date_parts[0]
            )
        ) {
            wc_add_notice(
                'تاریخ انتخاب‌شده معتبر نیست.',
                'error'
            );
            return;
        }

        /*
         * اعتبارسنجی ساعت شروع
         */

        if (
            ! preg_match(
                '/^(\d{1,2}):(\d{2})$/',
                $time,
                $time_match
            )
        ) {
            wc_add_notice(
                'ساعت رزرو نامعتبر است.',
                'error'
            );
            return;
        }

        $start_hour = (int) $time_match[1];
        $start_minute = (int) $time_match[2];

        if (
            $start_hour < 0 ||
            $start_hour > 23 ||
            $start_minute !== 0
        ) {
            wc_add_notice(
                'ساعت شروع رزرو معتبر نیست.',
                'error'
            );
            return;
        }

        /*
         * تنظیمات گیمنت
         */

        if (
            ! function_exists( 'lobix_product_get_settings' ) ||
            ! function_exists( 'lobix_product_get_capacity' ) ||
            ! function_exists( 'lobix_product_get_booked_slots' )
        ) {
            wc_add_notice(
                'توابع موردنیاز سیستم رزرو در دسترس نیستند.',
                'error'
            );
            return;
        }

        $settings = lobix_product_get_settings( $product_id );

        if (
            ! is_array( $settings ) ||
            ! isset(
                $settings['booking_mode'],
                $settings['stock_status'],
                $settings['work_start'],
                $settings['work_end']
            )
        ) {
            wc_add_notice(
                'تنظیمات رزرو قابل دریافت نیست.',
                'error'
            );
            return;
        }

        if ( $settings['booking_mode'] === 'manual' ) {
            wc_add_notice(
                'رزرو آنلاین برای این گیمنت غیرفعال است.',
                'error'
            );
            return;
        }

        if ( $settings['stock_status'] === 'outofstock' ) {
            wc_add_notice(
                'در حال حاضر این گیمنت امکان رزرو ندارد.',
                'error'
            );
            return;
        }

        /*
         * کنترل ساعات کاری
         */

        $work_start = (int) $settings['work_start'];
        $work_end = (int) $settings['work_end'];

        if (
            $work_start < 0 ||
            $work_end > 24 ||
            $work_start >= $work_end ||
            $start_hour < $work_start ||
            $start_hour >= $work_end ||
            ( $start_hour + $hours ) > $work_end
        ) {
            wc_add_notice(
                'این بازه خارج از ساعات کاری گیمنت است.',
                'error'
            );
            return;
        }

        /*
         * کنترل محدوده تاریخ رزرو
         */

        try {

            $selected_date = new DateTimeImmutable(
                $date_iso . ' 12:00:00',
                wp_timezone()
            );

            $today = new DateTimeImmutable(
                'today',
                wp_timezone()
            );

            $max_date = $today->modify( '+7 days' );

        } catch ( Exception $e ) {

            wc_add_notice(
                'تاریخ رزرو معتبر نیست.',
                'error'
            );
            return;
        }

        if (
            $selected_date < $today ||
            $selected_date > $max_date
        ) {
            wc_add_notice(
                'تاریخ انتخاب‌شده دیگر قابل رزرو نیست.',
                'error'
            );
            return;
        }

        // جلوگیری قطعی از ثبت رزرو برای ساعت گذشته؛ حتی اگر درخواست از مرورگر دست‌کاری شود.
        try {
            $requested_start = new DateTimeImmutable(
                $date_iso . ' ' . sprintf( '%02d:00:00', $start_hour ),
                wp_timezone()
            );
            $server_now = new DateTimeImmutable( 'now', wp_timezone() );
        } catch ( Exception $e ) {
            wc_add_notice( 'تاریخ یا ساعت رزرو معتبر نیست.', 'error' );
            return;
        }
        if ( $requested_start <= $server_now ) {
            wc_add_notice( 'ساعت شروع انتخاب‌شده گذشته است. لطفاً یک ساعت آینده را انتخاب کنید.', 'error' );
            return;
        }

        /*
         * دریافت رزروهای قبلی
         *
         * آرایه شامل ظرفیت رزروشده و شماره دستگاه‌ها است.
         */

        $booked = lobix_product_get_booked_slots(
            $product_id,
            $date_iso,
            $hours
        );

        $reservation_session_key = lobix_reservation_get_session_key();
        lobix_reservation_apply_active_holds( $product_id, $booked, $date_iso, $reservation_session_key );

        if ( ! is_array( $booked ) ) {
            wc_add_notice(
                'بررسی ظرفیت رزرو امکان‌پذیر نیست. دوباره تلاش کنید.',
                'error'
            );
            return;
        }

        /*
         * افزودن رزروهای موجود در سبد خرید به محاسبات موقت.
         *
         * این کار از انتخاب مجدد دستگاهی که همین حالا در سبد
         * خرید همین مشتری رزرو شده جلوگیری می‌کند.
         */

        foreach ( WC()->cart->get_cart() as $cart_item ) {

            if (
                empty( $cart_item['product_id'] ) ||
                absint( $cart_item['product_id'] ) !== $product_id ||
                empty( $cart_item['variation_id'] ) ||
                empty( $cart_item['lx_date_iso'] ) ||
                empty( $cart_item['lx_start_time'] ) ||
                empty( $cart_item['lx_hours'] )
            ) {
                continue;
            }

            if (
                ! preg_match(
                    '/^\d{4}-\d{2}-\d{2}$/',
                    (string) $cart_item['lx_date_iso']
                )
            ) {
                continue;
            }

            if ( $cart_item['lx_date_iso'] !== $date_iso ) {
                continue;
            }

            if (
                ! preg_match(
                    '/^(\d{1,2}):(\d{2})$/',
                    (string) $cart_item['lx_start_time'],
                    $cart_time_match
                )
            ) {
                continue;
            }

            $cart_start = (int) $cart_time_match[1];
            $cart_minute = (int) $cart_time_match[2];
            $cart_hours = max(
                1,
                absint( $cart_item['lx_hours'] )
            );

            if (
                $cart_start < 0 ||
                $cart_start > 23 ||
                $cart_minute !== 0
            ) {
                continue;
            }

            $cart_variation_id = absint(
                $cart_item['variation_id']
            );

            $cart_system_number = isset(
                $cart_item['lx_system_number']
            )
                ? trim(
                    (string) $cart_item['lx_system_number']
                )
                : '';
            $cart_system_id = isset( $cart_item['lx_system_id'] )
                ? sanitize_text_field( (string) $cart_item['lx_system_id'] ) : '';

            for (
                $cart_hour = $cart_start;
                $cart_hour < ( $cart_start + $cart_hours );
                $cart_hour++
            ) {

                if ( $cart_hour > 23 ) {
                    break;
                }

                if ( ! isset( $booked[$date_iso][$cart_hour] ) ) {
                    $booked[$date_iso][$cart_hour] = [];
                }

                if (
                    ! isset(
                        $booked[$date_iso][$cart_hour][$cart_variation_id]
                    )
                ) {
                    $booked[$date_iso][$cart_hour][$cart_variation_id] = 0;
                }

                $booked[$date_iso][$cart_hour][$cart_variation_id] += max(
                    1,
                    absint( $cart_item['quantity'] ?? 1 )
                );

                if ( $cart_system_id !== '' ) {
                    if ( ! isset( $booked[$date_iso][$cart_hour]['_physical_ids'][$cart_variation_id] ) ) {
                        $booked[$date_iso][$cart_hour]['_physical_ids'][$cart_variation_id] = [];
                    }
                    $booked[$date_iso][$cart_hour]['_physical_ids'][$cart_variation_id][$cart_system_id] = true;
                }

                if ( $cart_system_number !== '' ) {

                    if (
                        ! isset(
                            $booked[$date_iso][$cart_hour]['_physical']
                                [$cart_variation_id]
                        )
                    ) {
                        $booked[$date_iso][$cart_hour]['_physical']
                            [$cart_variation_id] = [];
                    }

                    $booked[$date_iso][$cart_hour]['_physical']
                        [$cart_variation_id][$cart_system_number] = true;
                }
            }
        }

        /*
         * اعتبارسنجی سیستم‌ها، شماره فیزیکی و بازی
         */

        $validated_systems = [];
        $selected_physical_numbers = [];
        $variation_counts = [];

        foreach ( $systems as $sys ) {

            if ( ! is_array( $sys ) ) {
                wc_add_notice(
                    'اطلاعات یکی از سیستم‌ها نامعتبر است.',
                    'error'
                );
                return;
            }

            $variation_id = isset( $sys['id'] )
                ? absint( $sys['id'] )
                : 0;

            $quantity = isset( $sys['qty'] )
                ? absint( $sys['qty'] )
                : 0;

            $system_number = isset( $sys['system_number'] )
                && is_scalar( $sys['system_number'] )
                    ? trim(
                        sanitize_text_field(
                            (string) $sys['system_number']
                        )
                    )
                    : '';

            $game_id = isset( $sys['game_id'] )
                ? absint( $sys['game_id'] )
                : 0;
            $system_id = isset( $sys['system_id'] ) && is_scalar( $sys['system_id'] )
                ? sanitize_text_field( (string) $sys['system_id'] ) : '';

            if (
                ! $variation_id ||
                $quantity !== 1 ||
                $system_number === '' ||
                ! $game_id
            ) {
                wc_add_notice(
                    'برای هر سیستم باید شماره فیزیکی، بازی و تعداد معتبر انتخاب شده باشد.',
                    'error'
                );
                return;
            }

            /*
             * اعتبارسنجی تنوع محصول
             */

            $variation = wc_get_product( $variation_id );

            if (
                ! $variation ||
                ! $variation->is_type( 'variation' ) ||
                (int) $variation->get_parent_id() !== $product_id
            ) {
                wc_add_notice(
                    'یکی از سیستم‌های انتخاب‌شده معتبر نیست.',
                    'error'
                );
                return;
            }

            /*
             * شماره فیزیکی باید در تنظیمات تنوع موجود باشد.
             */

            if (
                ! function_exists(
                    'lobix_reservation_get_system_numbers'
                )
            ) {
                wc_add_notice(
                    'امکان بررسی شماره سیستم‌ها وجود ندارد.',
                    'error'
                );
                return;
            }

            $allowed_numbers =
                lobix_reservation_get_system_numbers(
                    $variation_id
                );

            if ( ! is_array( $allowed_numbers ) ) {
                $allowed_numbers = [];
            }

            $allowed_numbers = array_map(
                'strval',
                $allowed_numbers
            );

            if (
                ! in_array(
                    $system_number,
                    $allowed_numbers,
                    true
                )
            ) {
                wc_add_notice(
                    'شماره سیستم «' .
                    esc_html( $system_number ) .
                    '» برای این مدل معتبر نیست.',
                    'error'
                );
                return;
            }

            /*
             * تطبیق شناسه پایدار با رجیستری واقعی API 2.4.2.
             * در نسخه‌های قدیمی بدون شناسه، فقط از رجیستری موجود resolve می‌کنیم؛
             * هرگز system_id ساختگی تولید نمی‌شود.
             */
            $physical_registry = lobix_reservation_get_physical_registry( $product_id );
            $matched_device = null;
            foreach ( $physical_registry as $registered_device ) {
                if ( (int) $registered_device['variation_id'] !== (int) $variation_id ) continue;
                if ( lobix_reservation_system_number_key( $registered_device['number'] ) !== lobix_reservation_system_number_key( $system_number ) ) continue;
                $matched_device = $registered_device;
                break;
            }
            $variation_has_registry = false;
            foreach ( $physical_registry as $registered_device ) {
                if ( (int) $registered_device['variation_id'] === (int) $variation_id ) { $variation_has_registry = true; break; }
            }
            if ( $variation_has_registry && ! $matched_device && $system_id === '' ) {
                wc_add_notice( 'این شماره دستگاه در رجیستری فیزیکی API برای این مدل ثبت نشده است؛ فهرست دستگاه‌ها را با نرم‌افزار گیمنت همگام کنید.', 'error' );
                return;
            }
            if ( $system_id !== '' ) {
                $id_device = null;
                foreach ( $physical_registry as $registered_device ) {
                    if ( hash_equals( (string) $registered_device['system_id'], $system_id ) ) { $id_device = $registered_device; break; }
                }
                if ( ! $id_device || (int) $id_device['variation_id'] !== (int) $variation_id ||
                    lobix_reservation_system_number_key( $id_device['number'] ) !== lobix_reservation_system_number_key( $system_number ) ) {
                    wc_add_notice( 'شناسه دستگاه انتخاب‌شده با نوع سرویس یا شماره دستگاه هماهنگ نیست.', 'error' );
                    return;
                }
                $matched_device = $id_device;
            } elseif ( $matched_device ) {
                $system_id = (string) $matched_device['system_id'];
            }
            if ( $matched_device && empty( $matched_device['active'] ) ) {
                wc_add_notice( 'این دستگاه غیرفعال است و امکان رزرو آن وجود ندارد.', 'error' );
                return;
            }

            /*
             * جلوگیری از انتخاب تکراری یک شماره در همین درخواست
             */

            $physical_key = $system_id !== '' ? 'id:' . $system_id : ( $variation_id . ':' . $system_number );

            if ( isset( $selected_physical_numbers[$physical_key] ) ) {
                wc_add_notice(
                    'یک سیستم فیزیکی را نمی‌توان بیش از یک بار انتخاب کرد.',
                    'error'
                );
                return;
            }

            $selected_physical_numbers[$physical_key] = true;

            /*
             * بازی باید از فهرست بازی‌های مجاز این تنوع باشد.
             */

            if (
                ! function_exists(
                    'lobix_reservation_get_allowed_games'
                )
            ) {
                wc_add_notice(
                    'امکان بررسی بازی‌های مجاز وجود ندارد.',
                    'error'
                );
                return;
            }

            $allowed_games =
                lobix_reservation_get_allowed_games(
                    $product_id,
                    $variation_id
                );

            if ( ! is_array( $allowed_games ) ) {
                $allowed_games = [];
            }

            $valid_game = false;
            $validated_game_name = '';

            foreach ( $allowed_games as $allowed_game ) {

                $allowed_game_id = 0;
                $allowed_game_name = '';

                if ( $allowed_game instanceof WP_Post ) {

                    $allowed_game_id = (int) $allowed_game->ID;
                    $allowed_game_name = get_the_title(
                        $allowed_game_id
                    );

                } elseif (
                    is_object( $allowed_game ) &&
                    isset( $allowed_game->ID )
                ) {

                    $allowed_game_id = (int) $allowed_game->ID;
                    $allowed_game_name = get_the_title(
                        $allowed_game_id
                    );

                } elseif ( is_array( $allowed_game ) ) {

                    $allowed_game_id = absint(
                        $allowed_game['id'] ??
                        $allowed_game['ID'] ??
                        0
                    );

                    $allowed_game_name = (string) (
                        $allowed_game['name'] ??
                        $allowed_game['title'] ??
                        (
                            $allowed_game_id
                                ? get_the_title( $allowed_game_id )
                                : ''
                        )
                    );

                } else {

                    $allowed_game_id = absint( $allowed_game );

                    if ( $allowed_game_id ) {
                        $allowed_game_name = get_the_title(
                            $allowed_game_id
                        );
                    }
                }

                if (
                    $allowed_game_id === $game_id &&
                    $allowed_game_name !== '' &&
                    get_post_status( $allowed_game_id ) === 'publish' &&
                    get_post_type( $allowed_game_id ) === 'lobix_game'
                ) {
                    $valid_game = true;

                    $validated_game_name = sanitize_text_field(
                        $allowed_game_name
                    );

                    break;
                }
            }

            if ( ! $valid_game ) {
                wc_add_notice(
                    'بازی انتخاب‌شده برای سیستم «' .
                    esc_html( $system_number ) .
                    '» مجاز نیست.',
                    'error'
                );
                return;
            }

            /*
             * ذخیره شمارش تنوع‌ها برای کنترل ظرفیت کلی
             */

            if ( ! isset( $variation_counts[$variation_id] ) ) {
                $variation_counts[$variation_id] = [
                    'count' => 0,
                    'name'  => $variation->get_name(),
                ];
            }

            $variation_counts[$variation_id]['count']++;

            $validated_systems[] = [
                'variation_id' => $variation_id,
                'quantity'     => 1,
                'name'         => $variation->get_name(),
                'system_number'=> $system_number,
                'system_id'    => $system_id,
                'game_id'      => $game_id,
                'game_name'    => $validated_game_name,
            ];
        }

        if ( empty( $validated_systems ) ) {
            wc_add_notice(
                'هیچ سیستم معتبری برای رزرو انتخاب نشده است.',
                'error'
            );
            return;
        }

        /*
         * بررسی اشغال بودن شماره فیزیکی در تمام ساعت‌های رزرو
         */

        foreach ( $validated_systems as $sys ) {

            $variation_id = $sys['variation_id'];
            $system_number = $sys['system_number'];

            for (
                $hour = $start_hour;
                $hour < ( $start_hour + $hours );
                $hour++
            ) {

                $physical_ids = $booked[$date_iso][$hour]['_physical_ids'][$variation_id] ?? [];
                $physical_bookings = $booked[$date_iso][$hour]['_physical'][$variation_id] ?? [];
                $system_id_busy = ! empty( $sys['system_id'] ) && is_array( $physical_ids ) && isset( $physical_ids[$sys['system_id']] );
                $system_number_busy = false;
                if ( is_array( $physical_bookings ) ) {
                    foreach ( $physical_bookings as $booked_number => $is_busy ) {
                        if ( $is_busy && lobix_reservation_system_number_key( $booked_number ) === lobix_reservation_system_number_key( $system_number ) ) {
                            $system_number_busy = true;
                            break;
                        }
                    }
                }

                if ( $system_id_busy || $system_number_busy ) {
                    wc_add_notice(
                        'سیستم شماره «' .
                        esc_html( $system_number ) .
                        '» در ساعت ' .
                        sprintf( '%02d:00', $hour ) .
                        ' قبلاً رزرو شده است. لطفاً سیستم دیگری انتخاب کنید.',
                        'error'
                    );
                    return;
                }
            }
        }

        /*
         * بررسی ظرفیت کلی هر تنوع در تمام ساعت‌های بازه
         */

        foreach ( $variation_counts as $variation_id => $selection ) {

            $capacity = max(
                0,
                (int) lobix_product_get_capacity(
                    (int) $variation_id,
                    $product_id
                )
            );

            $minimum_available = $capacity;

            for (
                $hour = $start_hour;
                $hour < ( $start_hour + $hours );
                $hour++
            ) {

                $reserved = isset(
                    $booked[$date_iso][$hour][$variation_id]
                )
                    ? absint(
                        $booked[$date_iso][$hour][$variation_id]
                    )
                    : 0;

                $available = max(
                    0,
                    $capacity - $reserved
                );

                $minimum_available = min(
                    $minimum_available,
                    $available
                );
            }

            if ( $selection['count'] > $minimum_available ) {
                wc_add_notice(
                    'ظرفیت «' .
                    esc_html( $selection['name'] ) .
                    '» برای این بازه کافی نیست. ظرفیت باقی‌مانده: ' .
                    $minimum_available .
                    ' سیستم.',
                    'error'
                );
                return;
            }
        }

        /*
         * قفل موقت جهانی برای هر دستگاه/ساعت تا پایان پرداخت یا انقضای سبد.
         */
        if ( $reservation_session_key === '' ) {
            wc_add_notice( 'نشست رزرو شما معتبر نیست. صفحه را تازه‌سازی کنید و دوباره تلاش کنید.', 'error' );
            return;
        }
        $hold_result = lobix_reservation_claim_holds( $product_id, $date_iso, $start_hour, $hours, $validated_systems, $reservation_session_key );
        if ( is_wp_error( $hold_result ) ) {
            wc_add_notice( $hold_result->get_error_message(), 'error' );
            return;
        }
        foreach ( $validated_systems as $hold_index => &$hold_system ) {
            $hold_system['hold_keys'] = $hold_result['by_system'][ $hold_index ] ?? array();
        }
        unset( $hold_system );

        /*
         * آماده‌سازی آیتم‌های رزرو
         *
         * هر دستگاه فیزیکی یک آیتم مستقل است.
         */

        $cart_items_to_add = [];

        foreach ( $validated_systems as $sys ) {

            $variation = wc_get_product(
                $sys['variation_id']
            );

            if (
                ! $variation ||
                ! $variation->is_type( 'variation' )
            ) {
                lobix_reservation_release_hold_keys( $hold_result['keys'], $reservation_session_key );
                wc_add_notice(
                    'اطلاعات یکی از مدل‌های انتخاب‌شده دیگر معتبر نیست.',
                    'error'
                );
                return;
            }

            $cart_item_data = [
                'lx_hours'         => $hours,
                'lx_date_iso'      => $date_iso,
                'lx_start_time'    => $time,
                'lx_system_number' => $sys['system_number'],
                'lx_system_id'     => $sys['system_id'],
                'lx_hold_keys'     => $sys['hold_keys'],
                'lx_game_id'       => $sys['game_id'],
                'lx_game_name'     => $sys['game_name'],

                'lx_display_data'  => [
                    'سیستم'       => $sys['name'],
                    'شماره سیستم' => $sys['system_number'],
                    'بازی'        => $sys['game_name'],
                    'زمان شروع'   => $time,
                    'تاریخ'       => $date,
                    'مدت رزرو'    => $hours . ' ساعت',
                ],
            ];

            $cart_items_to_add[] = [
                'product_id'   => $product_id,
                'quantity'     => 1,
                'variation_id' => $sys['variation_id'],
                'variation'    => $variation->get_variation_attributes(),
                'cart_item_data' => $cart_item_data,
            ];
        }

        /*
         * افزودن به سبد خرید
         *
         * سبد قبلی مشتری پیشاپیش خالی نمی‌شود.
         * در صورت شکست، فقط آیتم‌هایی که همین درخواست افزوده
         * حذف می‌شوند.
         */

        $added_cart_keys = [];

        foreach ( $cart_items_to_add as $item ) {

            $cart_item_key = WC()->cart->add_to_cart(
                $item['product_id'],
                $item['quantity'],
                $item['variation_id'],
                $item['variation'],
                $item['cart_item_data']
            );

            if ( ! $cart_item_key ) {

                foreach ( $added_cart_keys as $added_key ) {
                    WC()->cart->remove_cart_item( $added_key );
                }
                lobix_reservation_release_hold_keys( $hold_result['keys'], $reservation_session_key );

                wc_add_notice(
                    'افزودن یکی از سیستم‌ها به سبد خرید انجام نشد. لطفاً دوباره تلاش کنید.',
                    'error'
                );

                return;
            }

            $added_cart_keys[] = $cart_item_key;
        }

        /*
         * رفتن به تسویه‌حساب
         */

        wp_safe_redirect(
            wc_get_checkout_url()
        );

        exit;
    }
}

/* ============================================================
 * 14. HOURLY PRICE
 * ============================================================ */

add_action(
    'woocommerce_before_calculate_totals',
    'lobix_product_apply_hourly_price',
    20,
    1
);

if (
    ! function_exists(
        'lobix_product_apply_hourly_price'
    )
) {

    function lobix_product_apply_hourly_price(
        $cart
    ) {

        if (
            is_admin() &&
            ! defined('DOING_AJAX')
        ) {
            return;
        }

        if (
            ! $cart ||
            ! is_a($cart, 'WC_Cart')
        ) {
            return;
        }

        foreach (
            $cart->get_cart()
            as $cart_item
        ) {

            if (
                empty($cart_item['variation_id']) ||
                empty($cart_item['data'])
            ) {
                continue;
            }

            $hours = isset($cart_item['lx_hours'])
                ? max(1, absint($cart_item['lx_hours']))
                : 1;

            $variation = wc_get_product(
                absint($cart_item['variation_id'])
            );

            if (
                ! $variation ||
                ! $variation->exists()
            ) {
                continue;
            }

            $base_price = (float) $variation->get_price();

            $cart_item['data']->set_price(
                $base_price * $hours
            );
        }
    }
}

/* ============================================================
 * 15. CART DISPLAY
 * ============================================================ */

add_filter(
    'woocommerce_get_item_data',
    'lobix_product_display_reservation_data',
    10,
    2
);

if (
    ! function_exists(
        'lobix_product_display_reservation_data'
    )
) {

    function lobix_product_display_reservation_data(
        $item_data,
        $cart_item
    ) {

        if (
            empty(
                $cart_item[
                    'lx_display_data'
                ]
            ) ||
            ! is_array(
                $cart_item[
                    'lx_display_data'
                ]
            )
        ) {

            return $item_data;
        }

        foreach (
            $cart_item[
                'lx_display_data'
            ] as $label => $value
        ) {

            $item_data[] = [

                'name' =>
                    sanitize_text_field(
                        $label
                    ),

                'value' =>
                    sanitize_text_field(
                        $value
                    ),

            ];
        }

        return $item_data;
    }
}

/* ============================================================
 * 16. SAVE ORDER META
 * ============================================================ */

add_action(
    'woocommerce_checkout_create_order_line_item',
    'lobix_product_save_reservation_meta',
    10,
    4
);

if (
    ! function_exists(
        'lobix_product_save_reservation_meta'
    )
) {

    function lobix_product_save_reservation_meta(
        $item,
        $cart_item_key,
        $values,
        $order
    ) {

        // Save display data.
        if (
            ! empty($values['lx_display_data']) &&
            is_array($values['lx_display_data'])
        ) {

            foreach (
                $values['lx_display_data']
                as $label => $value
            ) {

                $item->update_meta_data(
                    sanitize_text_field($label),
                    sanitize_text_field((string) $value)
                );
            }
        }

        // Save reservation date.
        if (isset($values['lx_date_iso'])) {

            $item->update_meta_data(
                '_lx_date_iso',
                sanitize_text_field(
                    $values['lx_date_iso']
                )
            );
        }

        // Save start time.
        if (isset($values['lx_start_time'])) {

            $item->update_meta_data(
                '_lx_start_time',
                sanitize_text_field(
                    $values['lx_start_time']
                )
            );
        }

        // Save reservation duration.
        if (isset($values['lx_hours'])) {

            $item->update_meta_data(
                '_lx_hours',
                max(1, absint($values['lx_hours']))
            );
        }

        // Save physical system number.
        if (isset($values['lx_system_number'])) {

            $item->update_meta_data(
                '_lx_system_number',
                sanitize_text_field(
                    (string) $values['lx_system_number']
                )
            );
        }

        // Save stable physical system ID. API 2.4.2 continues to read the legacy number.
        if (isset($values['lx_system_id']) && $values['lx_system_id'] !== '') {
            $item->update_meta_data( '_lx_system_id', sanitize_text_field( (string) $values['lx_system_id'] ) );
        }
        if ( ! empty( $values['lx_hold_keys'] ) && is_array( $values['lx_hold_keys'] ) ) {
            $item->update_meta_data( '_lx_reservation_hold_keys', array_values( array_filter( $values['lx_hold_keys'], 'is_string' ) ) );
        }

        // Save selected game ID.
        if (isset($values['lx_game_id'])) {

            $item->update_meta_data(
                '_lx_game_id',
                absint($values['lx_game_id'])
            );
        }

        // Save selected game name.
        if (isset($values['lx_game_name'])) {

            $item->update_meta_data(
                '_lx_game_name',
                sanitize_text_field(
                    (string) $values['lx_game_name']
                )
            );
        }
    }
}
